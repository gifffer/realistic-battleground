--!strict
-- Flamethrower: the Pyromaniac's home-made flamethrower, on anyone whose
-- "Kit" attribute is "Pyromaniac" (clones and corpses too). Look only, on
-- every client: built here, driven by what the server already replicates
-- ("Kit", "Awakened", "Stunned", "Ragdolled", the Humanoid's health) and by
-- the clip beats (PyroFx calls draw / trigger / ... on every client).
--
-- The gun is the validated model (tools/pyro/flamethrower.py): the
-- imported FBX when ReplicatedStorage.Assets has a "Flamethrower" model
-- (docs/FLAMETHROWER_FR.md), else rebuilt from Roblox primitives
-- (Combat/FlamethrowerShape, generated by tools/pyro/flamethrower_parts.py).
--
--   Flamethrower.watch(model)              dressed while it is a Pyromaniac
--   Flamethrower.draw(model, seconds?)     from the back to the hands (Right
--                                          Arm weld, the validated hold)
--   Flamethrower.port(model, seconds?)     stood upright in the right hand
--                                          (the finisher's pilot ritual)
--   Flamethrower.holster(model, seconds?)  back across the back (Torso weld)
--   Flamethrower.fumble(model)             cut short: trigger off, pilot out,
--                                          slung in 0.15 s
--   Flamethrower.isDrawn(model)
--   Flamethrower.point(model, name)        an attachment: "Muzzle" (LookVector
--                                          = where the jet goes), "PilotLight",
--                                          "GripR", "GripL", "Stock",
--                                          "BackMount", "ShroudGlow",
--                                          "GaugeFace", "Regulator"
--   Flamethrower.muzzle(model)             point(model, "Muzzle")
--   Flamethrower.setPilot(model, on)       the blue pilot flame (bigger, an
--                                          orange tip, while Awakened)
--   Flamethrower.trigger(model, pulled)    the trigger and the cable-pulled
--                                          valve; a release puffs smoke out
--                                          of the shroud holes
--   Flamethrower.setValve(model, open)     the ball valve lever: -1 choked,
--                                          0 rest, 1 open
--   Flamethrower.crankValve(model, s?)     the bottle's handwheel spun, the
--                                          gauge pegged red for a moment
--   Flamethrower.setGauge(model, v?)       the needle (0..1; nil: automatic)
--   Flamethrower.setHeat(model, level)     extra heat 0..1 (Inferno 0.75,
--                                          finisher 1); his Awakening alone
--                                          gives 0.55. Glow through the
--                                          drilled holes, red-hot skin above
--                                          0.8
--   Flamethrower.vent(model)               the finisher's relief valve: a
--                                          white hiss upward, the heat dies
--
-- Every part only shows (no collisions, no queries, no mass), welded to an
-- invisible root; the root is welded to the Torso (slung) or the Right Arm
-- (drawn), so it follows the clips and the ragdoll.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local PyroConfig = require(ReplicatedStorage.Shared.PyroConfig)
local FireLook = require(script.Parent.FireLook)
local Shape = require(script.Parent.FlamethrowerShape)

local Flamethrower = {}

local FOLDER = "Flamethrower"
-- The finisher's upright hold (Right Arm space): the gun stood up across his
-- chest, the pilot burner by his left shoulder. Written by
-- tools/anim/pyro_clips.py --write (solved with the clip).
local PORT = CFrame.new(
	-0.8921,
	-0.3331,
	-0.6422,
	0.2702,
	0.4839,
	0.8323,
	-0.4938,
	0.8118,
	-0.3117,
	-0.8265,
	-0.3268,
	0.4583
)
local DRAW_TIME = 0.12
local FUMBLE_TIME = 0.15
local AWAKENED_HEAT = 0.55
local TRIGGER_PULL = math.rad(15)
local VALVE_OPEN = math.rad(-38) -- lever along the pipe
local VALVE_CHOKE = math.rad(52) -- lever across the pipe
local GAUGE_REST = 0.4
local GAUGE_AWAKENED = 0.9
local NEEDLE_ZERO = math.rad(225) -- the dial: 225 deg (0) to -45 deg (1)
local NEEDLE_SPAN = math.rad(270)

local PILOT_BLUE = Color3.fromRGB(90, 140, 255)
local PILOT_CORE = Color3.fromRGB(225, 235, 255)
local PILOT_TIP = Color3.fromRGB(255, 150, 60)
local GLOW = Color3.fromRGB(255, 120, 40)
local GLOW_HOT = Color3.fromRGB(255, 70, 25)
local SHELL = Color3.fromRGB(190, 50, 15)
local HOLE_COLD = Shape.PAINTS.Hole.color
local SPARK_TEXTURE = "rbxasset://textures/particles/sparkles_main.dds"

type Gun = {
	model: Model,
	folder: Folder,
	root: BasePart,
	mount: Weld,
	mountTween: Tween?,
	hinges: { [string]: Weld },
	points: { [string]: Attachment },
	holes: { BasePart },
	shells: { BasePart },
	cores: { BasePart },
	pilot: { ParticleEmitter },
	pilotLight: PointLight,
	glowLight: PointLight,
	smoke: ParticleEmitter,
	hiss: ParticleEmitter,
	drawn: boolean,
	pilotOn: boolean,
	-- the moving bits: where they are, where they go
	trigger: number,
	triggerTarget: number,
	valve: number,
	valveTarget: number,
	wheel: number,
	wheelSpin: number, -- radians still to turn
	gauge: number,
	gaugeSet: number?,
	pegUntil: number,
	heat: number,
	heatBoost: number,
	shownHeat: number, -- (the holes repainted only when it moved)
	-- what the hinges and the pilot last showed (rewritten only on a change)
	shownTrigger: number,
	shownValve: number,
	shownNeedle: number,
	shownPilotSize: number,
	shownPilotSpeed: number,
	shownPilotAwake: boolean?,
	ventUntil: number,
	connections: { RBXScriptConnection },
}

local guns: { [Model]: Gun } = setmetatable({}, { __mode = "k" }) :: any

------------------------------------------------------------------------------
-- The parts: the imported mesh fitted to gun space, or the primitives
------------------------------------------------------------------------------

type Piece = {
	source: BasePart?, -- a MeshPart of the imported model (nil: a primitive)
	def: Shape.PartDef?,
	cf: CFrame, -- gun space
	size: Vector3,
	paint: string,
	group: string,
}

local meshPieces: { Piece }? = nil
local meshLacking: Instance? = nil
local warned = false

-- The imported FBX, fitted: three part centres give its frame and scale
-- (whatever axes and units the importer used), a fourth checks the fit.
local function fitMesh(): { Piece }?
	if meshPieces then
		return meshPieces
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local model = if assets then assets:FindFirstChild(FOLDER, true) else nil
	if model == nil or model == meshLacking then
		return nil
	end
	local parts: { [string]: BasePart } = {}
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and Shape.MESH_PAINT[item.Name] then
			parts[item.Name] = item
		end
	end
	local fit = Shape.MESH_FIT
	local a, b, c, check =
		parts[fit[1].name], parts[fit[2].name], parts[fit[3].name], parts[fit[4].name]
	local function lacking(why: string): nil
		if not warned then
			warned = true
			warn("[Flamethrower] " .. why .. ": built from parts (docs/FLAMETHROWER_FR.md).")
		end
		meshLacking = model
		model.DescendantAdded:Once(function()
			if meshLacking == model then
				meshLacking = nil
			end
		end)
		return nil
	end
	if not (a and b and c and check) then
		return lacking("the imported Flamethrower lacks parts")
	end
	local function frameOf(pa: Vector3, pb: Vector3, pc: Vector3): CFrame
		local x = (pa - pb).Unit
		local z = x:Cross(pc - pb).Unit
		return CFrame.fromMatrix(pb, x, z:Cross(x), z)
	end
	local expected = frameOf(fit[1].centre, fit[2].centre, fit[3].centre)
	local found = frameOf(a.Position, b.Position, c.Position)
	local scale = (a.Position - b.Position).Magnitude / (fit[1].centre - fit[2].centre).Magnitude
	local function toGun(cf: CFrame): CFrame
		local relative = found:ToObjectSpace(cf)
		return expected * (CFrame.new(relative.Position / scale) * relative.Rotation)
	end
	if (toGun(check.CFrame).Position - fit[4].centre).Magnitude > 0.25 then
		return lacking("the imported Flamethrower does not fit (mirrored or edited?)")
	end
	local pieces: { Piece } = {}
	for name, source in parts do
		table.insert(pieces, {
			source = source,
			cf = toGun(source.CFrame),
			size = source.Size / scale,
			paint = Shape.MESH_PAINT[name],
			group = Shape.MESH_GROUP[name] or "Body",
		})
	end
	-- What the mesh has no part for: the dial and its needle, the heat.
	for _, def in Shape.PARTS do
		if
			def.group == "Face"
			or def.group == "Needle"
			or def.group == "Shell"
			or def.group == "Core"
		then
			local piece: Piece =
				{ def = def, cf = def.cf, size = def.size, paint = def.paint, group = def.group }
			table.insert(pieces, piece)
		end
	end
	meshPieces = pieces
	return pieces
end

local primitivePieces: { Piece }? = nil
local function primitives(): { Piece }
	if primitivePieces then
		return primitivePieces
	end
	local pieces: { Piece } = {}
	for _, def in Shape.PARTS do
		if def.group ~= "Core" then
			local piece: Piece =
				{ def = def, cf = def.cf, size = def.size, paint = def.paint, group = def.group }
			table.insert(pieces, piece)
		end
	end
	primitivePieces = pieces
	return pieces
end

local function showOnly(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

local function makePart(piece: Piece): BasePart
	local part: BasePart
	if piece.source then
		part = piece.source:Clone()
		part:ClearAllChildren()
		part.PivotOffset = CFrame.identity
	else
		local def = piece.def :: Shape.PartDef
		local p = Instance.new("Part")
		p.Name = def.name
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		if def.shape == "Cyl" then
			p.Shape = Enum.PartType.Cylinder
		elseif def.shape == "Wedge" then
			p.Shape = Enum.PartType.Wedge
		elseif def.shape == "Sphere" then
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Parent = p
		end
		part = p
	end
	showOnly(part)
	part.Size = piece.size
	local paint = Shape.PAINTS[piece.paint]
	part.Color = paint.color
	part.Material = paint.material
	part.Reflectance = paint.shine
	-- (the shells and the core only show when hot; the large parts cast shadows)
	if piece.group == "Shell" or piece.group == "Core" then
		part.Transparency = 1
	else
		part.CastShadow = piece.size.Magnitude > 0.6
	end
	return part
end

local function weldTo(base: BasePart, part: BasePart, offset: CFrame, name: string?): Weld
	part.CFrame = base.CFrame * offset
	local w = Instance.new("Weld")
	if name then
		w.Name = name
	end
	w.Part0 = base
	w.Part1 = part
	w.C0 = offset
	w.Parent = part
	return w
end

------------------------------------------------------------------------------
-- Dressing
------------------------------------------------------------------------------

local function emitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.LightInfluence = 0
	for key, value in props do
		(e :: any)[key] = value
	end
	e.Parent = parent
	return e
end

local function buildPilot(at: Attachment): ({ ParticleEmitter }, PointLight)
	local texture = FireLook.image("glow") or SPARK_TEXTURE
	local flame = emitter(at, {
		Name = "PilotFlame",
		Texture = texture,
		Color = ColorSequence.new(PILOT_BLUE),
		LightEmission = 1,
		Brightness = 2,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.07),
			NumberSequenceKeypoint.new(1, 0.02),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.1, 0.14),
		Speed = NumberRange.new(1.1, 1.4),
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(4, 4),
		LockedToPart = true,
		Rate = 0,
		ZOffset = 0.2,
	})
	local core = emitter(at, {
		Name = "PilotCore",
		Texture = texture,
		Color = ColorSequence.new(PILOT_CORE),
		LightEmission = 1,
		Brightness = 3,
		Size = NumberSequence.new(0.035),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.2),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.06, 0.08),
		Speed = NumberRange.new(0.5, 0.6),
		EmissionDirection = Enum.NormalId.Front,
		LockedToPart = true,
		Rate = 0,
		ZOffset = 0.25,
	})
	local light = Instance.new("PointLight")
	light.Color = PILOT_BLUE
	light.Brightness = 0.4
	light.Range = 3
	light.Shadows = false
	light.Enabled = false
	light.Parent = at
	return { flame, core }, light
end

local function removeGun(model: Model)
	local gun = guns[model]
	guns[model] = nil
	if gun == nil then
		return
	end
	for _, connection in gun.connections do
		connection:Disconnect()
	end
	if gun.mountTween then
		gun.mountTween:Cancel()
	end
	gun.folder:Destroy()
end

local function bodyPart(model: Model, name: string): BasePart?
	local part = model:FindFirstChild(name)
	return if part and part:IsA("BasePart") then part else nil
end

-- Your own character: the camera hides it in first person; the gun follows.
local function followModifier(torso: BasePart, gun: Gun)
	local function follow()
		for _, item in gun.folder:GetDescendants() do
			if item:IsA("BasePart") then
				item.LocalTransparencyModifier = torso.LocalTransparencyModifier
			end
		end
	end
	table.insert(
		gun.connections,
		torso:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(follow)
	)
	follow()
end

local fumbleGun: (gun: Gun) -> ()

local function dress(model: Model)
	removeGun(model)
	local torso = bodyPart(model, "Torso")
	if torso == nil then
		return
	end
	-- (a body copied on this client - a corpse - carries the old gun: redrawn)
	for _, child in model:GetChildren() do
		if child.Name == FOLDER and child:IsA("Folder") then
			child:Destroy()
		end
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	local root = Instance.new("Part")
	root.Name = "GunRoot"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	showOnly(root)
	root.CFrame = torso.CFrame * Shape.SLING
	root.Parent = folder
	local mount = Instance.new("Weld")
	mount.Name = "GunMount"
	mount.Part0 = torso
	mount.Part1 = root
	mount.C0 = Shape.SLING
	mount.Parent = root

	-- the moving bits turn on hinges (invisible) welded at their pivot
	local hinges: { [string]: Weld } = {}
	local hingeParts: { [string]: BasePart } = {}
	for group, pivot in Shape.PIVOTS do
		local hinge = Instance.new("Part")
		hinge.Name = "Hinge" .. group
		hinge.Size = Vector3.new(0.05, 0.05, 0.05)
		hinge.Transparency = 1
		showOnly(hinge)
		hinges[group] = weldTo(root, hinge, pivot)
		hinge.Parent = folder
		hingeParts[group] = hinge
	end

	local holes, shells, cores = {}, {}, {}
	for _, piece in fitMesh() or primitives() do
		local part = makePart(piece)
		local hinge = hingeParts[piece.group]
		if hinge then
			weldTo(hinge, part, (Shape.PIVOTS :: any)[piece.group]:Inverse() * piece.cf)
		else
			weldTo(root, part, piece.cf)
		end
		if piece.group == "Holes" then
			table.insert(holes, part)
		elseif piece.group == "Shell" then
			table.insert(shells, part)
		elseif piece.group == "Core" then
			table.insert(cores, part)
		end
		part.Parent = folder
	end

	local points: { [string]: Attachment } = {}
	for name, at in Shape.POINTS do
		local attachment = Instance.new("Attachment")
		attachment.Name = name
		attachment.CFrame = at
		attachment.Parent = root
		points[name] = attachment
	end
	local pilot, pilotLight = buildPilot(points.PilotLight)
	local glowLight = Instance.new("PointLight")
	glowLight.Color = GLOW
	glowLight.Brightness = 0
	glowLight.Range = 4
	glowLight.Shadows = false
	glowLight.Enabled = false
	glowLight.Parent = points.ShroudGlow
	-- smoke out of the holes (after firing; a wisp while it runs hot)
	local smoke = FireLook.layer("smoke", points.ShroudGlow, 0.12, "HoleSmoke")
	smoke.Speed = NumberRange.new(0.4, 0.9)
	smoke.Acceleration = Vector3.new(0, 1.5, 0)
	smoke.Lifetime = NumberRange.new(0.9, 1.4)
	smoke.SpreadAngle = Vector2.new(180, 180)
	-- the relief valve's white hiss (finisher)
	local hiss = emitter(points.Regulator, {
		Name = "VentHiss",
		Texture = FireLook.image("smoke") or "rbxasset://textures/particles/smoke_main.dds",
		Color = ColorSequence.new(Color3.fromRGB(235, 232, 225)),
		LightEmission = 0.3,
		Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.12),
			NumberSequenceKeypoint.new(1, 1.4),
		}),
		Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 1),
		}),
		Lifetime = NumberRange.new(0.5, 0.8),
		Speed = NumberRange.new(9, 12),
		Drag = 3,
		EmissionDirection = Enum.NormalId.Front,
		SpreadAngle = Vector2.new(6, 6),
		Rate = 0,
	})

	local gun: Gun = {
		model = model,
		folder = folder,
		root = root,
		mount = mount,
		mountTween = nil,
		hinges = hinges,
		points = points,
		holes = holes,
		shells = shells,
		cores = cores,
		pilot = pilot,
		pilotLight = pilotLight,
		glowLight = glowLight,
		smoke = smoke,
		hiss = hiss,
		drawn = false,
		pilotOn = false,
		trigger = 0,
		triggerTarget = 0,
		valve = 0,
		valveTarget = 0,
		wheel = 0,
		wheelSpin = 0,
		gauge = GAUGE_REST,
		gaugeSet = nil,
		pegUntil = 0,
		heat = 0,
		heatBoost = 0,
		shownHeat = -1,
		shownTrigger = -1,
		shownValve = -2,
		shownNeedle = -1,
		shownPilotSize = -1,
		shownPilotSpeed = -1,
		shownPilotAwake = nil,
		ventUntil = 0,
		connections = {},
	}
	folder.Parent = model
	guns[model] = gun
	if model == Players.LocalPlayer.Character then
		followModifier(torso, gun)
	end

	-- Cut short by the fight: stunned, knocked down, dead.
	local function check()
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		if
			model:GetAttribute("Stunned") == true
			or model:GetAttribute("Ragdolled") == true
			or (humanoid ~= nil and humanoid.Health <= 0)
		then
			fumbleGun(gun)
		end
	end
	table.insert(gun.connections, model:GetAttributeChangedSignal("Stunned"):Connect(check))
	table.insert(gun.connections, model:GetAttributeChangedSignal("Ragdolled"):Connect(check))
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		table.insert(gun.connections, humanoid.HealthChanged:Connect(check))
	end
	-- (gone with its torso: re-dressed if the model still is his)
	table.insert(
		gun.connections,
		folder.Destroying:Connect(function()
			if guns[model] == gun then
				removeGun(model)
			end
		end)
	)
end

------------------------------------------------------------------------------
-- States
------------------------------------------------------------------------------

-- The root welded to `base` at `target`, from where it is now (no pop).
local function remount(gun: Gun, base: BasePart, target: CFrame, seconds: number)
	if gun.mountTween then
		gun.mountTween:Cancel()
		gun.mountTween = nil
	end
	local mount = gun.mount
	local world = gun.root.CFrame
	mount.Part0 = base
	if seconds <= 0 then
		mount.C0 = target
		return
	end
	mount.C0 = base.CFrame:ToObjectSpace(world)
	local tween = TweenService:Create(
		mount,
		TweenInfo.new(seconds, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ C0 = target }
	)
	gun.mountTween = tween
	tween:Play()
end

local function setPilotOn(gun: Gun, on: boolean)
	if gun.pilotOn == on then
		return
	end
	gun.pilotOn = on
	if not on then
		gun.smoke:Emit(1) -- (a small puff)
	end
end

local function slung(gun: Gun, seconds: number)
	local torso = bodyPart(gun.model, "Torso")
	gun.drawn = false
	if torso then
		remount(gun, torso, Shape.SLING, seconds)
	end
end

fumbleGun = function(gun: Gun)
	gun.triggerTarget = 0
	gun.valveTarget = 0
	setPilotOn(gun, false)
	if gun.drawn then
		slung(gun, FUMBLE_TIME)
	end
end

-- Eases `value` toward `target` at `rate` per second.
local function approach(value: number, target: number, rate: number, dt: number): number
	if value < target then
		return math.min(target, value + rate * dt)
	end
	return math.max(target, value - rate * dt)
end

local function paintHeat(gun: Gun, heat: number)
	local glow = GLOW:Lerp(GLOW_HOT, math.clamp((heat - 0.55) / 0.45, 0, 1))
	for _, hole in gun.holes do
		if heat > 0.04 then
			hole.Material = Enum.Material.Neon
			hole.Color = HOLE_COLD:Lerp(glow, math.clamp(heat / 0.55, 0, 1))
		else
			hole.Material = Enum.Material.SmoothPlastic
			hole.Color = HOLE_COLD
		end
	end
	for _, core in gun.cores do
		core.Color = glow
		core.Transparency = if heat > 0.04 then 1 - math.clamp(heat / 0.55, 0, 1) * 0.65 else 1
		if heat > 0.55 then
			core.Transparency = 0.35 * (1 - (heat - 0.55) / 0.45)
		end
	end
	local hot = math.clamp((heat - 0.8) / 0.2, 0, 1)
	for _, shell in gun.shells do
		shell.Material = Enum.Material.Neon
		shell.Color = SHELL
		shell.Transparency = if hot > 0 then 0.75 - 0.3 * hot else 1
	end
	gun.glowLight.Enabled = heat > 0.04
	gun.glowLight.Brightness = heat * 1.6
	gun.glowLight.Range = 3 + heat * 5
	gun.glowLight.Color = glow
end

local function step(dt: number)
	local now = os.clock()
	for model, gun in guns do
		if gun.folder.Parent ~= model then
			continue
		end
		local awake = model:GetAttribute("Awakened") == true
		-- drawn on an arm that is gone (torn off): back on the torso
		if gun.drawn then
			local arm = gun.mount.Part0
			if arm == nil or arm.Parent ~= model then
				slung(gun, 0)
			end
		end
		-- the levers
		gun.trigger = approach(gun.trigger, gun.triggerTarget, 14, dt)
		gun.valve = approach(gun.valve, gun.valveTarget, 9, dt)
		local hinges = gun.hinges
		local pivots = Shape.PIVOTS :: any
		if hinges.Trigger and gun.trigger ~= gun.shownTrigger then
			gun.shownTrigger = gun.trigger
			hinges.Trigger.C0 = pivots.Trigger * CFrame.Angles(0, TRIGGER_PULL * gun.trigger, 0)
		end
		if hinges.Valve and gun.valve ~= gun.shownValve then
			gun.shownValve = gun.valve
			local angle = if gun.valve >= 0
				then VALVE_OPEN * gun.valve
				else VALVE_CHOKE * -gun.valve
			hinges.Valve.C0 = pivots.Valve * CFrame.Angles(0, 0, angle)
		end
		if gun.wheelSpin > 0 and hinges.Wheel then
			local turn = math.min(gun.wheelSpin, 14 * dt)
			gun.wheelSpin -= turn
			gun.wheel = (gun.wheel + turn) % (2 * math.pi)
			hinges.Wheel.C0 = pivots.Wheel * CFrame.Angles(gun.wheel, 0, 0)
		end
		-- the gauge: set, pegged by a crank, jittering high while Awakened
		local target = gun.gaugeSet or (if awake then GAUGE_AWAKENED else GAUGE_REST)
		if now < gun.pegUntil then
			target = 1
		elseif gun.gaugeSet == nil and awake then
			target += math.noise(now * 9, gun.root.Position.X) * 0.08
		end
		gun.gauge = approach(gun.gauge, math.clamp(target, 0, 1), 3, dt)
		if hinges.Needle and math.abs(gun.gauge - gun.shownNeedle) > 0.002 then
			gun.shownNeedle = gun.gauge
			hinges.Needle.C0 = pivots.Needle
				* CFrame.Angles(0, 0, NEEDLE_ZERO - NEEDLE_SPAN * gun.gauge)
		end
		-- heat: up fast, down slowly (fast while venting)
		local heatTarget = if now < gun.ventUntil
			then 0
			else math.max(if awake then AWAKENED_HEAT else 0, gun.heatBoost)
		gun.heat = approach(
			gun.heat,
			heatTarget,
			if heatTarget > gun.heat then 1.5 elseif now < gun.ventUntil then 0.5 else 0.3,
			dt
		)
		if math.abs(gun.heat - gun.shownHeat) > 0.01 then
			gun.shownHeat = gun.heat
			paintHeat(gun, gun.heat)
		end
		gun.smoke.Rate = if gun.heat > 0.4 then 2 + gun.heat * 4 else 0
		-- the pilot: blue; bigger, licking orange, while Awakened; flaring
		-- with the trigger
		local on = gun.pilotOn
		local k = (if awake then 1.8 else 1) * (1 + gun.trigger * 0.4)
		local flame, core = gun.pilot[1], gun.pilot[2]
		flame.Rate = if on then 90 else 0
		core.Rate = if on then 70 else 0
		if on then
			-- (the flicker quantised: the sequences rebuilt only when it moved)
			local flick = 1
				+ math.noise(now * 13, gun.root.Position.Z) * (if awake then 0.35 else 0.12)
			local speed = math.floor(k * flick * 20 + 0.5) / 20
			if speed ~= gun.shownPilotSpeed then
				gun.shownPilotSpeed = speed
				flame.Speed = NumberRange.new(1.1 * speed, 1.4 * speed)
			end
			local size = math.floor(k * 20 + 0.5) / 20
			if size ~= gun.shownPilotSize then
				gun.shownPilotSize = size
				flame.Size = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.07 * size),
					NumberSequenceKeypoint.new(1, 0.02 * size),
				})
			end
			if awake ~= gun.shownPilotAwake then
				gun.shownPilotAwake = awake
				flame.Color = if awake
					then ColorSequence.new({
						ColorSequenceKeypoint.new(0, PILOT_BLUE),
						ColorSequenceKeypoint.new(0.55, PILOT_BLUE),
						ColorSequenceKeypoint.new(1, PILOT_TIP),
					})
					else ColorSequence.new(PILOT_BLUE)
				flame.Acceleration = if awake then Vector3.new(0, 3, 0) else Vector3.zero
			end
		end
		gun.pilotLight.Enabled = on
		gun.pilotLight.Brightness = 0.4 * k
		gun.hiss.Rate = if now < gun.ventUntil - 0.5 then 60 else 0
	end
end

------------------------------------------------------------------------------
-- API
------------------------------------------------------------------------------

local watched: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local stepping: RBXScriptConnection? = nil

function Flamethrower.watch(model: Model)
	if watched[model] then
		return
	end
	watched[model] = true
	if stepping == nil then
		stepping = RunService.Heartbeat:Connect(step)
	end
	local function refresh()
		if model:GetAttribute("Kit") == PyroConfig.KIT_ID then
			local gun = guns[model]
			if gun == nil or gun.folder.Parent ~= model then
				dress(model)
			end
		else
			removeGun(model)
		end
	end
	model:GetAttributeChangedSignal("Kit"):Connect(refresh)
	-- (a torso arriving late: dressed then)
	model.ChildAdded:Connect(function(child: Instance)
		if child.Name == "Torso" and guns[model] == nil then
			task.defer(refresh)
		end
	end)
	refresh()
end

function Flamethrower.draw(model: Model, seconds: number?)
	local gun = guns[model]
	local arm = bodyPart(model, "Right Arm")
	if gun == nil or arm == nil then
		return
	end
	gun.drawn = true
	remount(gun, arm, Shape.GRIP, seconds or DRAW_TIME)
end

function Flamethrower.port(model: Model, seconds: number?)
	local gun = guns[model]
	local arm = bodyPart(model, "Right Arm")
	if gun == nil or arm == nil then
		return
	end
	gun.drawn = true
	remount(gun, arm, PORT, seconds or DRAW_TIME)
end

function Flamethrower.holster(model: Model, seconds: number?)
	local gun = guns[model]
	if gun == nil then
		return
	end
	gun.triggerTarget = 0
	slung(gun, seconds or DRAW_TIME)
end

function Flamethrower.fumble(model: Model)
	local gun = guns[model]
	if gun then
		fumbleGun(gun)
	end
end

function Flamethrower.isDrawn(model: Model): boolean
	local gun = guns[model]
	return gun ~= nil and gun.drawn
end

function Flamethrower.point(model: Model, name: string): Attachment?
	local gun = guns[model]
	return if gun then gun.points[name] else nil
end

function Flamethrower.muzzle(model: Model): Attachment?
	return Flamethrower.point(model, "Muzzle")
end

function Flamethrower.setPilot(model: Model, on: boolean)
	local gun = guns[model]
	if gun then
		setPilotOn(gun, on)
	end
end

function Flamethrower.trigger(model: Model, pulled: boolean)
	local gun = guns[model]
	if gun == nil then
		return
	end
	local was = gun.triggerTarget > 0
	gun.triggerTarget = if pulled then 1 else 0
	gun.valveTarget = if pulled then 1 else 0
	if was and not pulled then
		gun.smoke:Emit(4) -- (the holes puff after a burst)
	end
end

function Flamethrower.setValve(model: Model, open: number)
	local gun = guns[model]
	if gun then
		gun.valveTarget = math.clamp(open, -1, 1)
	end
end

function Flamethrower.crankValve(model: Model, seconds: number?)
	local gun = guns[model]
	if gun then
		local s = seconds or 0.6
		gun.wheelSpin += 14 * s
		gun.pegUntil = os.clock() + s
	end
end

function Flamethrower.setGauge(model: Model, value: number?)
	local gun = guns[model]
	if gun then
		gun.gaugeSet = value
	end
end

function Flamethrower.setHeat(model: Model, level: number)
	local gun = guns[model]
	if gun then
		gun.heatBoost = math.clamp(level, 0, 1)
	end
end

function Flamethrower.vent(model: Model)
	local gun = guns[model]
	if gun then
		gun.heatBoost = 0
		gun.ventUntil = os.clock() + 2
	end
end

return Flamethrower
