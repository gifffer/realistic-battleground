export type PartDef = {
	name: string,
	shape: string,
	cf: CFrame,
	size: Vector3,
	paint: string,
	group: string,
}

local function p(
	name: string,
	shape: string,
	cf: CFrame,
	size: Vector3,
	paint: string,
	group: string
): PartDef
	return { name = name, shape = shape, cf = cf, size = size, paint = paint, group = group }
end

export type Paint = { color: Color3, material: Enum.Material, shine: number }

local function paint(r: number, g: number, b: number, material: Enum.Material, shine: number): Paint
	return { color = Color3.fromRGB(r, g, b), material = material, shine = shine }
end

