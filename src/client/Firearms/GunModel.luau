--!strict
-- GunModel: dresses every character that carries a gun (the "Firearm" attribute,
-- set by Server/Systems/Firearms), on every client. Look only.
-- docs/firearms/ARCHITECTURE.md §6, docs/firearms/CORE.md.
--
-- The gun is the imported FBX when ReplicatedStorage.Assets.Guns.<Id> exists and
-- fits (three part centres give its frame and scale, a fourth checks it, as
-- Flamethrower.fitMesh), with its SurfaceAppearance (or one made from
-- assets/guns/texture_ids.json); otherwise it is built from code-made primitives
-- (Shared/Firearms/Models/<Id>.prims, generated by tools/guns/export_luau.py).
--
-- Structure (in a Folder "GunDressing" under the character):
--   GunRoot     invisible, gun space origin (the breech face); GunJoint, a Motor6D
--               Torso -> GunRoot: its C0 places the gun (carried or in the hands), its
--               Transform is free for the handling layer (part 2)
--   Hinge<Name> one invisible part per moving part, on a Motor6D at its pivot (nested:
--               a bipod extension rides its leg); the visible parts are welded to it
--   Attachments named after the markers (Muzzle, EjectionPort, CasingSpawn, MagWell,
--               SightEye, GripR...), on the part they move with
--   Holster / Strap  the hip holster (pistol) or the sling strap (long guns)
--
-- Driven by the replicated attributes: Firearm (dress / undress), GunDrawn (on the
-- body / in the hands), GunMag (-1 = no mag: hidden; the top round shows while > 0;
-- the LMG's belt shows min(12, rounds) links), GunBoltOpen (slide / bolt held back),
-- GunCoverOpen, GunBipod, GunMode (the selector's detent). Removed on unequip, death
-- and while ragdolled; never left on a corpse copy (strip).
--
--   GunModel.watch(model)               dress it whenever it carries a gun
--   GunModel.strip(model)               remove any dressing (a corpse copy)
--   GunModel.get(model)                 -> Gun? (the handles below)
--   GunModel.point(model, marker)       -> Attachment? ("Muzzle", "EjectionPort"...)
--   GunModel.setHinge(model, name, value, second?)
--                                       a moving part, in its JSON units (degrees /
--                                       studs, absolute: the rest value = as modelled)
--   GunModel.setGroupVisible(model, group, visible)
--   GunModel.feedParts(model)           -> { BasePart } the detachable feed (mag / pouch)
--   GunModel.setDriven(model, driven)   true: the handling layer places the gun (this
--                                       module stops moving GunJoint.C0 by itself)
--   GunModel.shotCycle(model)           the action cycling on a shot (slide / carrier /
--                                       bolt back for a frame, the trigger, the belt twitch)
--   GunModel.buildPrims(list, parent)   -> { BasePart } parts for a primitives list (casings)
--   GunModel.PAINTS                     the primitives' palette

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Firearms = require(ReplicatedStorage.Shared.Firearms)
local Types = require(ReplicatedStorage.Shared.Firearms.Types)

type Def = Types.FirearmDef
type Data = Types.GunModelData

local GunModel = {}

local FOLDER = "GunDressing"
-- seconds for the gun to travel between the carry and the hands when nothing drives
-- it (part 2's clips replace this): a damped approach, never a pop
local MOUNT_HALF_LIFE = 0.07
local MAX_STEP = math.rad(20) -- per 1/60 s: the rate limit of the repo's animations

export type Paint = { color: Color3, material: Enum.Material, reflectance: number }
local function paint(r: number, g: number, b: number, material: Enum.Material, reflectance: number?): Paint
	return { color = Color3.fromRGB(r, g, b), material = material, reflectance = reflectance or 0 }
end
-- Gritty, worn: blued steel nearly black, phosphate grey-green, oiled wood, matte polymer.
GunModel.PAINTS = table.freeze({
	Polymer = paint(30, 30, 31, Enum.Material.SmoothPlastic),
	SteelBlued = paint(34, 35, 39, Enum.Material.Metal),
	SteelBare = paint(96, 96, 98, Enum.Material.Metal),
	SteelPhosphate = paint(48, 50, 46, Enum.Material.Metal),
	SteelLacquer = paint(62, 54, 40, Enum.Material.Metal),
	Aluminium = paint(58, 58, 60, Enum.Material.Metal),
	Wood = paint(92, 46, 22, Enum.Material.Wood),
	Rubber = paint(22, 22, 22, Enum.Material.Fabric),
	Fabric = paint(38, 38, 34, Enum.Material.Fabric),
	FabricTan = paint(126, 104, 74, Enum.Material.Fabric),
	FabricCamo = paint(78, 84, 68, Enum.Material.Fabric),
	Brass = paint(176, 132, 62, Enum.Material.Metal),
	Copper = paint(160, 92, 52, Enum.Material.Metal),
	Nickel = paint(150, 150, 146, Enum.Material.Metal),
	Lens = paint(18, 28, 34, Enum.Material.Glass, 0.25),
	Glow = paint(255, 60, 40, Enum.Material.Neon),
	Bore = paint(8, 8, 8, Enum.Material.SmoothPlastic),
	SightPaint = paint(205, 200, 180, Enum.Material.SmoothPlastic),
	HullRed = paint(120, 24, 20, Enum.Material.SmoothPlastic),
})
local DEFAULT_PAINT = GunModel.PAINTS.SteelBlued

-- Markers that move with a part (else they sit on the gun root).
local MARKER_PART: { [string]: { string } } = {
	SlideGrip = { "Slide" },
	SightFront = { "Slide" },
	ChargeHandle = { "ChargingHandle", "BoltCarrier", "Bolt" },
	BoltKnob = { "Bolt" },
	BoltGrip = { "Bolt" },
	MagGrab = { "Magazine" },
	MagWell = {},
	PouchGrab = { "AmmoPouch" },
	FeedCoverLatch = { "FeedCover" },
	SightEye = { "FeedCover" }, -- (the LMG's prism rides the cover; elsewhere: no such hinge)
	BipodFoot = { "BipodLegL" },
}
-- The action that runs back on each shot (and stays back when locked open).
local CYCLE_PART: { [string]: string } = {
	Pistol = "Slide",
	Shotgun = "Bolt",
	Rifle = "BoltCarrier",
	Lmg = "",
	Sniper = "",
}

export type Gun = {
	model: Model,
	id: string,
	def: Def,
	data: Data,
	folder: Folder,
	root: BasePart,
	joint: Motor6D,
	hinges: { [string]: Motor6D },
	hingeParts: { [string]: BasePart },
	groups: { [string]: { BasePart } },
	points: { [string]: Attachment },
	carry: CFrame, -- GunJoint.C0 when carried
	hands: CFrame, -- GunJoint.C0 in the hands (the solved Ready hold)
	drawn: boolean,
	driven: boolean,
	mount: number, -- 0 carried .. 1 in the hands (shown)
	strap: BasePart?,
	holster: BasePart?,
	fromMesh: boolean,
	-- per-shot motion
	cycleAt: number,
	triggerAt: number,
	twitchAt: number,
	-- what the hinges show (written only on a change)
	shown: { [string]: number },
	connections: { RBXScriptConnection },
}

local guns: { [Model]: Gun } = setmetatable({}, { __mode = "k" }) :: any
local watched: { [Model]: boolean } = setmetatable({}, { __mode = "k" }) :: any

------------------------------------------------------------------------------
-- Parts
------------------------------------------------------------------------------

local function showOnly(part: BasePart)
	part.Anchored = false
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.CastShadow = false
end

local function applyPaint(part: BasePart, key: string)
	local p = (GunModel.PAINTS :: any)[key] or DEFAULT_PAINT
	part.Color = p.color
	part.Material = p.material
	part.Reflectance = p.reflectance
end

local function makePrim(def: Types.PrimDef): BasePart
	local p = Instance.new("Part")
	p.Name = def.name
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if def.shape == "Cyl" then
		p.Shape = Enum.PartType.Cylinder
	elseif def.shape == "Wedge" then
		p.Shape = Enum.PartType.Wedge
	end
	showOnly(p)
	p.Size = def.size
	applyPaint(p, def.paint)
	return p
end

-- Parts for a primitives list, welded to `parent` in their own frame (a casing, a
-- dropped mag). Returned so the caller can parent them.
function GunModel.buildPrims(list: { Types.PrimDef }, parent: BasePart): { BasePart }
	local out = {}
	for _, def in list do
		local part = makePrim(def)
		part.CFrame = parent.CFrame * def.cf
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = parent
		weld.Part1 = part
		weld.Parent = part
		table.insert(out, part)
	end
	return out
end

type Piece = {
	source: BasePart?,
	prim: Types.PrimDef?,
	name: string,
	cf: CFrame,
	size: Vector3,
	paint: string,
	group: string,
	atlas: string?,
}

local meshCache: { [string]: { Piece } | false } = {}
local warned: { [string]: boolean } = {}

-- The imported model, fitted to gun space (nil: build the primitives).
local function fitMesh(data: Data): { Piece }?
	local cached = meshCache[data.id]
	if cached ~= nil then
		return if cached == false then nil else cached
	end
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = if assets then assets:FindFirstChild("Guns") else nil
	local model = if folder then folder:FindFirstChild(data.id) else nil
	if model == nil then
		return nil -- (not imported yet: no cache, it may arrive later)
	end
	local function lacking(why: string): nil
		if not warned[data.id] then
			warned[data.id] = true
			warn(`[GunModel] {data.id}: {why}; built from primitives (docs/firearms/CORE.md).`)
		end
		meshCache[data.id] = false
		return nil
	end
	local parts: { [string]: BasePart } = {}
	for _, item in model:GetDescendants() do
		if item:IsA("BasePart") and data.parts[item.Name] then
			parts[item.Name] = item
		end
	end
	local fit = data.fit
	if #fit < 4 then
		return lacking("no fit parts")
	end
	local a, b, c, check = parts[fit[1].name], parts[fit[2].name], parts[fit[3].name], parts[fit[4].name]
	if not (a and b and c and check) then
		return lacking("the imported model lacks its fit parts")
	end
	local function frameOf(pa: Vector3, pb: Vector3, pc: Vector3): CFrame
		local x = (pa - pb).Unit
		local z = x:Cross(pc - pb).Unit
		return CFrame.fromMatrix(pb, x, z:Cross(x), z)
	end
	local expected = frameOf(fit[1].centre, fit[2].centre, fit[3].centre)
	local found = frameOf(a.Position, b.Position, c.Position)
	local scale = (a.Position - b.Position).Magnitude / (fit[1].centre - fit[2].centre).Magnitude
	local function toGun(cf: CFrame): CFrame
		local relative = found:ToObjectSpace(cf)
		return expected * (CFrame.new(relative.Position / scale) * relative.Rotation)
	end
	if (toGun(check.CFrame).Position - fit[4].centre).Magnitude > 0.08 then
		return lacking("the imported model does not fit (mirrored, scaled unevenly or edited?)")
	end
	local pieces: { Piece } = {}
	for name, source in parts do
		local info = data.parts[name]
		table.insert(pieces, {
			source = source,
			name = name,
			cf = toGun(source.CFrame),
			size = source.Size / scale,
			paint = info.paint,
			group = info.group,
			atlas = info.atlas,
		})
	end
	meshCache[data.id] = pieces
	return pieces
end

local function primitives(data: Data): { Piece }
	local pieces: { Piece } = {}
	for _, def in data.prims do
		table.insert(pieces, {
			prim = def,
			name = def.name,
			cf = def.cf,
			size = def.size,
			paint = def.paint,
			group = def.group,
		})
	end
	return pieces
end

local function asset(id: number): string
	return if id ~= 0 then `rbxassetid://{id}` else ""
end

-- The atlas on an imported MeshPart: its own SurfaceAppearance if the import kept
-- one, else a new one (where the engine lets scripts set its maps), else the colour
-- map as TextureID.
local function dressMesh(part: BasePart, data: Data, atlas: string?)
	if part:FindFirstChildOfClass("SurfaceAppearance") then
		return
	end
	local ids = if atlas then data.atlases[atlas] else nil
	if ids == nil then
		return
	end
	local ok = pcall(function()
		local look = Instance.new("SurfaceAppearance")
		look.ColorMap = asset(ids.color)
		look.NormalMap = asset(ids.normal)
		look.RoughnessMap = asset(ids.roughness)
		look.MetalnessMap = asset(ids.metalness)
		look.Parent = part
	end)
	if not ok and part:IsA("MeshPart") and ids.color ~= 0 then
		pcall(function()
			(part :: MeshPart).TextureID = asset(ids.color)
		end)
	end
end

local function makePiece(piece: Piece, data: Data): BasePart
	local part: BasePart
	local source = piece.source
	if source then
		part = source:Clone()
		for _, child in part:GetChildren() do
			if not child:IsA("SurfaceAppearance") then
				child:Destroy()
			end
		end
		showOnly(part)
		part.Size = piece.size
		if part:IsA("MeshPart") then
			part.RenderFidelity = Enum.RenderFidelity.Automatic
		end
		dressMesh(part, data, piece.atlas)
	else
		part = makePrim(piece.prim :: Types.PrimDef)
	end
	part.Name = piece.name
	-- (the larger parts cast shadows)
	part.CastShadow = piece.size.Magnitude > 0.8
	return part
end

------------------------------------------------------------------------------
-- Dressing
------------------------------------------------------------------------------

local function bodyPart(model: Model, name: string): BasePart?
	local part = model:FindFirstChild(name)
	return if part and part:IsA("BasePart") then part else nil
end

local function remove(model: Model)
	local gun = guns[model]
	guns[model] = nil
	if gun then
		for _, connection in gun.connections do
			connection:Disconnect()
		end
		gun.folder:Destroy()
	end
end

function GunModel.strip(model: Model)
	remove(model)
	for _, child in model:GetChildren() do
		if child.Name == FOLDER and child:IsA("Folder") then
			child:Destroy()
		end
	end
end

local function hingeCFrame(info: Types.HingeInfo, value: number, second: number?): CFrame
	local delta = value - info.rest
	local motion: CFrame
	if info.type == "rotate" then
		motion = CFrame.fromAxisAngle(info.axis, math.rad(delta))
	elseif info.type == "slide" or info.type == "detach" then
		motion = CFrame.new(info.axis * delta)
	else
		motion = CFrame.identity
	end
	local chained = info["then"]
	if chained and second and second ~= 0 then
		if chained.type == "slide" then
			motion = CFrame.new(chained.axis * second) * motion
		else
			motion = CFrame.fromAxisAngle(chained.axis, math.rad(second)) * motion
		end
	end
	return motion
end

local function carryCFrame(def: Def, data: Data): CFrame
	local markerName = if def.carry.kind == "Hip" then "HolsterMount" else "BackMount"
	local marker = data.markers[markerName] or data.markers.CoM or CFrame.identity
	return def.carry.cf * marker:Inverse()
end

local function handsCFrame(data: Data): CFrame
	local hold = data.holds.Ready or data.holds.Aim
	if hold and hold.gunInTorso then
		return hold.gunInTorso
	end
	return CFrame.new(0.6, 0.5, -1.2)
end

-- The pistol's holster (polymer, open-top, on the right hip) or a long gun's strap
-- across the chest (shown while slung).
local function carryDressing(gun: Gun, torso: BasePart)
	local def, data = gun.def, gun.data
	if def.carry.kind == "Hip" then
		local frame = data.parts.Frame or data.parts.Slide
		local length = if frame then frame.size.Z + 0.06 else 0.7
		local holster = Instance.new("Part")
		holster.Name = "Holster"
		showOnly(holster)
		holster.Size = Vector3.new(0.17, 0.42, length * 0.78)
		applyPaint(holster, "Polymer")
		holster.Color = Color3.fromRGB(24, 24, 24)
		-- the slide's length, from the breech face forward, in gun space
		local inGun = CFrame.new(0, 0.12, -length * 0.42)
		holster.CFrame = torso.CFrame * gun.carry * inGun
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = holster
		weld.Parent = holster
		holster.Parent = gun.folder
		gun.holster = holster
	else
		local strap = Instance.new("Part")
		strap.Name = "Strap"
		showOnly(strap)
		local from, to = Vector3.new(-0.78, 1.02, -0.53), Vector3.new(0.82, -0.98, -0.53)
		if def.carry.cf.LookVector.Y < 0 then
			from, to = Vector3.new(0.78, 1.02, -0.53), Vector3.new(-0.82, -0.98, -0.53)
		end
		strap.Size = Vector3.new(0.17, 0.035, (to - from).Magnitude)
		strap.Material = Enum.Material.Fabric
		strap.Color = def.carry.strap or Color3.fromRGB(40, 38, 34)
		strap.CFrame = torso.CFrame * CFrame.lookAt((from + to) / 2, to)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = torso
		weld.Part1 = strap
		weld.Parent = strap
		strap.Parent = gun.folder
		gun.strap = strap
	end
end

local function followModifier(torso: BasePart, gun: Gun)
	local function follow()
		for _, item in gun.folder:GetDescendants() do
			if item:IsA("BasePart") then
				item.LocalTransparencyModifier = torso.LocalTransparencyModifier
			end
		end
	end
	table.insert(gun.connections, torso:GetPropertyChangedSignal("LocalTransparencyModifier"):Connect(follow))
	follow()
end

local function dress(model: Model, id: string)
	GunModel.strip(model)
	local def = Firearms.get(id)
	local data = Firearms.model(id)
	local torso = bodyPart(model, "Torso")
	if def == nil or data == nil or torso == nil then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	local root = Instance.new("Part")
	root.Name = "GunRoot"
	root.Size = Vector3.new(0.1, 0.1, 0.1)
	root.Transparency = 1
	showOnly(root)
	local carry = carryCFrame(def, data)
	root.CFrame = torso.CFrame * carry
	root.Parent = folder
	local joint = Instance.new("Motor6D")
	joint.Name = "GunJoint"
	joint.Part0 = torso
	joint.Part1 = root
	joint.C0 = carry
	joint.Parent = root

	-- hinges, parents first (a bipod extension rides its leg)
	local hinges: { [string]: Motor6D } = {}
	local hingeParts: { [string]: BasePart } = {}
	local pending: { string } = {}
	for name in data.hinges do
		table.insert(pending, name)
	end
	table.sort(pending)
	local guard = 0
	while #pending > 0 and guard < 50 do
		guard += 1
		for index = #pending, 1, -1 do
			local name = pending[index]
			local info = data.hinges[name]
			local parentName = info.parent
			local parentPart = if parentName == "Body" then root else hingeParts[parentName]
			if parentPart then
				local parentPivot = if parentName == "Body" then Vector3.zero else data.hinges[parentName].pivot
				local hinge = Instance.new("Part")
				hinge.Name = "Hinge" .. name
				hinge.Size = Vector3.new(0.05, 0.05, 0.05)
				hinge.Transparency = 1
				showOnly(hinge)
				hinge.CFrame = root.CFrame * CFrame.new(info.pivot)
				local motor = Instance.new("Motor6D")
				motor.Name = name
				motor.Part0 = parentPart
				motor.Part1 = hinge
				motor.C0 = CFrame.new(info.pivot - parentPivot)
				motor.Parent = hinge
				hinge.Parent = folder
				hinges[name] = motor
				hingeParts[name] = hinge
				table.remove(pending, index)
			end
		end
	end

	local gun: Gun = {
		model = model,
		id = id,
		def = def,
		data = data,
		folder = folder,
		root = root,
		joint = joint,
		hinges = hinges,
		hingeParts = hingeParts,
		groups = {},
		points = {},
		carry = carry,
		hands = handsCFrame(data),
		drawn = false,
		driven = false,
		mount = 0,
		strap = nil,
		holster = nil,
		fromMesh = false,
		cycleAt = -math.huge,
		triggerAt = -math.huge,
		twitchAt = -math.huge,
		shown = {},
		connections = {},
	}

	local pieces = fitMesh(data)
	gun.fromMesh = pieces ~= nil
	for _, piece in pieces or primitives(data) do
		local part = makePiece(piece, data)
		local hinge = hingeParts[piece.group]
		local base = hinge or root
		local pivot = if hinge then data.hinges[piece.group].pivot else Vector3.zero
		local offset = CFrame.new(-pivot) * piece.cf
		part.CFrame = base.CFrame * offset
		local weld = Instance.new("Weld")
		weld.Part0 = base
		weld.Part1 = part
		weld.C0 = offset
		weld.Parent = part
		part.Parent = folder
		local list = gun.groups[piece.group]
		if list == nil then
			list = {}
			gun.groups[piece.group] = list
		end
		table.insert(list, part)
		-- (the top round and a part's own name are groups too: shown / hidden alone)
		if piece.name ~= piece.group then
			local own = gun.groups[piece.name]
			if own == nil then
				own = {}
				gun.groups[piece.name] = own
			end
			table.insert(own, part)
		end
	end

	-- points
	for name, cf in data.markers do
		local holder: BasePart = root
		local pivot = Vector3.zero
		for _, candidate in MARKER_PART[name] or {} do
			if hingeParts[candidate] then
				holder = hingeParts[candidate]
				pivot = data.hinges[candidate].pivot
				break
			end
		end
		local at = Instance.new("Attachment")
		at.Name = name
		at.CFrame = CFrame.new(-pivot) * cf
		at.Parent = holder
		gun.points[name] = at
	end

	carryDressing(gun, torso)
	folder.Parent = model
	guns[model] = gun
	if model == (game:GetService("Players").LocalPlayer.Character :: Model?) then
		followModifier(torso, gun)
	end
end

------------------------------------------------------------------------------
-- Driven by the attributes
------------------------------------------------------------------------------

function GunModel.setHinge(model: Model, name: string, value: number, second: number?)
	local gun = guns[model]
	local motor = if gun then gun.hinges[name] else nil
	if gun == nil or motor == nil then
		return
	end
	local info = gun.data.hinges[name]
	local key = value + (second or 0) * 1000
	if gun.shown[name] == key then
		return
	end
	gun.shown[name] = key
	motor.Transform = hingeCFrame(info, value, second)
end

function GunModel.setGroupVisible(model: Model, group: string, visible: boolean)
	local gun = guns[model]
	local list = if gun then gun.groups[group] else nil
	if list == nil then
		return
	end
	for _, part in list do
		part.Transparency = if visible then 0 else 1
	end
end

function GunModel.feedParts(model: Model): { BasePart }
	local gun = guns[model]
	local feed = if gun then gun.data.feed else nil
	if gun == nil or feed == nil then
		return {}
	end
	local out = {}
	for _, name in feed.members do
		for _, part in gun.groups[name] or {} do
			if not table.find(out, part) then
				table.insert(out, part)
			end
		end
	end
	return out
end

function GunModel.get(model: Model): Gun?
	return guns[model]
end

function GunModel.point(model: Model, name: string): Attachment?
	local gun = guns[model]
	return if gun then gun.points[name] else nil
end

function GunModel.setDriven(model: Model, driven: boolean)
	local gun = guns[model]
	if gun then
		gun.driven = driven
	end
end

function GunModel.shotCycle(model: Model)
	local gun = guns[model]
	if gun then
		local now = os.clock()
		gun.cycleAt = now
		gun.triggerAt = now
		gun.twitchAt = now
	end
end

-- The feed's attributes -> what the mag / belt / top round show.
local function refreshFeed(gun: Gun)
	local model = gun.model
	local mag = model:GetAttribute("GunMag")
	local rounds = if typeof(mag) == "number" then mag else gun.def.capacity
	local feed = gun.data.feed
	if feed then
		local visible = rounds >= 0
		for _, part in GunModel.feedParts(model) do
			part.Transparency = if visible then 0 else 1
		end
		if visible then
			GunModel.setGroupVisible(model, "MagRoundTop", rounds > 0)
		end
	end
	if gun.def.feed == "Belt" then
		for i = 1, 12 do
			GunModel.setGroupVisible(model, string.format("Belt%02d", i), rounds >= i)
		end
	end
end

local function refreshDrawn(gun: Gun)
	gun.drawn = gun.model:GetAttribute("GunDrawn") == true
	if gun.strap then
		gun.strap.Transparency = if gun.drawn then 1 else 0
	end
end

local function watchAttributes(gun: Gun)
	local model = gun.model
	local function on(name: string, fn: () -> ())
		table.insert(gun.connections, model:GetAttributeChangedSignal(name):Connect(fn))
	end
	on("GunMag", function()
		refreshFeed(gun)
	end)
	on("GunDrawn", function()
		refreshDrawn(gun)
	end)
	refreshFeed(gun)
	refreshDrawn(gun)
end

-- Every frame, for every dressed gun: the carry <-> hands travel (when nothing else
-- drives it) and the moving parts.
local function approach(current: number, target: number, dt: number, halfLife: number): number
	return target + (current - target) * 0.5 ^ (dt / halfLife)
end

local function step(dt: number)
	local now = os.clock()
	for model, gun in guns do
		if gun.folder.Parent ~= model then
			guns[model] = nil
			continue
		end
		local data, def = gun.data, gun.def
		-- placement: carried <-> hands (a damped approach, rotation limited per frame)
		if not gun.driven then
			local target = if gun.drawn then 1 else 0
			if gun.mount ~= target then
				local nextMount = approach(gun.mount, target, dt, MOUNT_HALF_LIFE)
				if math.abs(nextMount - target) < 0.002 then
					nextMount = target
				end
				local wanted = gun.carry:Lerp(gun.hands, nextMount)
				local current = gun.joint.C0
				local _, angle = (current:Inverse() * wanted):ToAxisAngle()
				local limit = MAX_STEP * dt * 60
				if math.abs(angle) > limit then
					wanted = current:Lerp(wanted, limit / math.abs(angle))
					nextMount = gun.mount + (nextMount - gun.mount) * limit / math.abs(angle)
				end
				gun.mount = nextMount
				gun.joint.C0 = wanted
			end
		end
		-- the action: held back when locked open, a one-frame kick on a shot
		local cyclePart = CYCLE_PART[def.id]
		if cyclePart and cyclePart ~= "" and data.hinges[cyclePart] then
			local info = data.hinges[cyclePart]
			local since = now - gun.cycleAt
			local back = model:GetAttribute("GunBoltOpen") == true
			local value = info.rest
			if back or since < 1 / 60 then
				value = info.max
			elseif since < 3 / 60 then
				value = info.max * (1 - (since - 1 / 60) / (2 / 60))
			end
			GunModel.setHinge(model, cyclePart, value)
		end
		-- the trigger: pressed on the shot, released over 80 ms
		if data.hinges.Trigger then
			local info = data.hinges.Trigger
			local since = now - gun.triggerAt
			local value = if since < 0.03 then info.max elseif since < 0.11 then info.max * (1 - (since - 0.03) / 0.08) else info.rest
			GunModel.setHinge(model, "Trigger", value)
		end
		-- the selector's detent (the AK: SAFE / AUTO / SEMI)
		local selector = data.hinges.Selector
		if selector and selector.detents then
			local mode = model:GetAttribute("GunMode")
			local detent = if mode == "Auto" then selector.detents.AUTO else selector.detents.SEMI
			if detent then
				GunModel.setHinge(model, "Selector", detent)
			end
		end
		-- the LMG's feed cover, bipods
		if data.hinges.FeedCover then
			local open = model:GetAttribute("GunCoverOpen") == true
			GunModel.setHinge(model, "FeedCover", if open then data.hinges.FeedCover.max else 0)
		end
		local deployed = model:GetAttribute("GunBipod") == true
		for _, leg in { "BipodLegL", "BipodLegR" } do
			local info = data.hinges[leg]
			if info then
				local target = if deployed then (if math.abs(info.max) > math.abs(info.min) then info.max else info.min) else info.rest
				GunModel.setHinge(model, leg, target)
			end
		end
		-- the LMG belt: one link pitch along the feed on each shot, back next frame
		if def.feed == "Belt" then
			local since = now - gun.twitchAt
			local offset = if since < 1 / 60 then -0.03 else 0
			for i = 1, 12 do
				local name = string.format("Belt%02d", i)
				local motor = gun.hinges[name]
				if motor and gun.shown[name] ~= offset then
					gun.shown[name] = offset
					motor.Transform = CFrame.new(offset, 0, 0)
				end
			end
		end
	end
end

------------------------------------------------------------------------------
-- Watching
------------------------------------------------------------------------------

function GunModel.watch(model: Model)
	if watched[model] then
		return
	end
	watched[model] = true
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local function refresh()
		local id = model:GetAttribute("Firearm")
		local ragdolled = model:GetAttribute("Ragdolled") == true
		local dead = humanoid ~= nil and humanoid.Health <= 0
		if typeof(id) ~= "string" or ragdolled or dead or model.Parent == nil then
			GunModel.strip(model)
			return
		end
		local gun = guns[model]
		if gun and gun.id == id then
			return
		end
		dress(model, id)
		local fresh = guns[model]
		if fresh then
			watchAttributes(fresh)
			-- start where the attributes say (no draw travel for a gun already out)
			fresh.drawn = model:GetAttribute("GunDrawn") == true
			fresh.mount = if fresh.drawn then 1 else 0
			fresh.joint.C0 = if fresh.drawn then fresh.hands else fresh.carry
			refreshDrawn(fresh)
		end
	end
	model:GetAttributeChangedSignal("Firearm"):Connect(refresh)
	model:GetAttributeChangedSignal("Ragdolled"):Connect(refresh)
	if humanoid then
		humanoid.Died:Connect(refresh)
	end
	model.AncestryChanged:Connect(function()
		if model.Parent == nil then
			GunModel.strip(model)
			watched[model] = nil
		end
	end)
	refresh()
end

function GunModel.start()
	RunService.PreSimulation:Connect(step)
	-- bodies copied on this client (corpses) never carry a gun
	CollectionService:GetInstanceAddedSignal(Config.Combat.CORPSE_TAG):Connect(function(item)
		if item:IsA("Model") then
			GunModel.strip(item)
		end
	end)
end

return GunModel
