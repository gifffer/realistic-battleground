--!strict
-- City: "Marrow District", the free arena, built by code when the server starts.
--
-- The district itself is DATA: the CityData1..N modules next to this script are generated by a
-- Python tool (citygen.py, kept outside the game) from the art direction document. They hold one
-- JSON text, split in pieces, that lists every part of the city (about 5 500 primitive parts:
-- a compact district for 16 players with 9 buildings, 3 shops you can walk into, the railway
-- viaduct, climb routes, props, the boundary ring) plus the spawn points. This script only
-- READS that list and creates the Instances. To change the city, change the generator and
-- export again; do not edit CityData by hand.
--
-- Everything goes into Workspace > City, one folder per zone ("Ground", "Buildings/B1", ...).
-- If a Folder named "City" already exists in Workspace (a hand-made map in the place file),
-- nothing is built: the hand-made map wins.
--
-- HEIGHTS: the road surface of the city is at Y = 1.2 (not 0). Studio's default Baseplate has
-- its top at Y = 0 and the default SpawnLocation its top at Y = 1.0: a city road at Y = 0 sat
-- exactly on the Baseplate, which made its grid texture flicker through the asphalt
-- ("z-fighting") and made the road look sunk. This script also removes the default Baseplate
-- and hides the default SpawnLocation (see cleanUpTemplate below), but only AFTER the city's
-- own ground exists, so nobody who spawns early falls into the void.
--
-- The build runs in the background, a few hundred parts at a time with task.wait() between
-- chunks, so the server never freezes. The spawn points and the whole ground (the "Ground"
-- folder: road slab, sidewalks, area floors) are created first, in the same frame, with no
-- wait in between.
--
-- Tags (CollectionService) used by Server/Systems/Ambience and the weather events:
--   CityLamp        lamp heads (child SpotLight / PointLight "Light"); attributes Dead, Flicker
--   CityNeon        neon signs (child SurfaceGui "Sign" + PointLight "Light"); attribute Flicker
--   CityPuddle      puddles; attribute RainOnly
--   CityWindowLit   window panes that light up at night; attributes Kind ("warm"/"tv"/"cold"), Day
--   CityWetSurface  big road / roof slabs (Reflectance up when it rains)
--   CityDrip        drip emitters (only on in rain)
--   CitySteam       steam vents (ParticleEmitter, attribute BaseRate)
--   CityFire        burn barrels; CityEmergency red exit lights (power cut only)
--   CityBulkhead, CityShopLight, CityGutter: other lights / gutter spouts
--   ShopCounter     the counters of the clothes shop (THREADBARE) and the emote shop (REWIND).
--                   Attributes ShopCategory ("Outfit" / "Emote"), PromptText, PromptObject.
--                   This script gives each one a ProximityPrompt named "ShopPrompt" (press E).
--                   The shop system listens to that prompt to open the shop menu on the right
--                   tab. The shop button of the menu still works as before.
--
-- BREAKABLE WALLS (for later, nothing breaks yet):
--   Every ground-floor wall element of the buildings is a separate anchored part tagged
--   "Breakable", with attributes Material ("Brick" | "Concrete" | "Wood" | "Glass" | "Metal"),
--   Health (Brick 120, Concrete 160, Wood 50, Glass 10, Metal 90), Facade (e.g. "B1_S"),
--   Row (1 = Y 0..8, 2 = Y 8..16) and Slot (the 8-stud column along the facade).
--   The standard panel is 8 x 8 x 1.2. Its decoration (glass, sills, bars, boards, lights...)
--   is parented UNDER the panel, so it goes with it. Nothing structural rests on a panel:
--   ceilings, upper floors, string courses and fascias are held by the core and corner piers.
--   Behind every panel there is a dark room 10 studs deep, so a character thrown through a
--   wall lands inside. Panels of one face are in City/Buildings/<Id>/Facade_<Face> (a Model).
--   Note: the upper walls, parapets and the bar's ceiling simply sit on top of the ground-floor
--   panels. They are anchored, so they stay in the air when a panel under them breaks (no
--   collapse to simulate); a wall-breaking system must not unanchor anything but the panel.
--   For the future physics: unanchor the hit panel (default densities: Brick 1.92,
--   Concrete 2.4, Wood 0.7, Glass 2.4, Metal 7.85), put the pieces in a "Debris" collision
--   group that does not collide with itself, clean them up after 20 s. Never weld panels.
--
-- MANNEQUINS: the 4 mannequins of the clothes shop are Models named "Mannequin" with the
-- attribute OutfitId (the data names their folder "Mannequin_<OutfitId>"); the client's
-- ShopFrontController dresses them in that outfit.
--
-- TRAINING DUMMIES: the data gives a clear, lit spot for them (the Cage court); it is stored on
-- the City folder as the attribute DummySpot (a Vector3), read by Server/Systems/TrainingDummies.
--
-- THE TRAIN (v5): the railway deck has ONE track lane (10 wide) between two railings, with a
-- walkway on each side and three level crossings. Both ends of the track run into a dark tunnel
-- behind a portal in the ring wall. The data gives the lane; this script stores it on the City
-- folder (set BEFORE the folder is parented, so a script that finds workspace.City can read
-- them right away; they may still be missing on a hand-made map, so wait / check for nil):
--   TrainA          Vector3: the rail-top centreline point 40 studs inside the WEST tunnel
--   TrainB          Vector3: the same point inside the EAST tunnel (the train runs A <-> B)
--   TrainLaneWidth  number: the width of the lane (10); a character inside it gets hit
-- The two signals at the deck's ends: a red lamp (part "TrainSignal", tag "TrainSignal", a
-- PointLight "Light", dark at rest) above a green one (part "SignalGo", tag "TrainSignalGo",
-- lit at rest), both with the attribute TrainEnd ("A" west / "B" east). The train code
-- (Client/Controllers/TrainController) blinks the red one and turns the green one off while a
-- train is coming or passing.
--
-- SALOON DOORS (v5): Duffy's corner entrance has two swinging half doors. Their parts carry the
-- usual CityDoor tag and attributes (DoorGroup "B12_Saloon", HingeX, HingeZ, OpenAngle = the
-- swing into the bar) plus DoorStyle = "Saloon"; they never collide. Server/Systems/CityDoors
-- swings them away from whoever walks through and lets them flap shut.
--
-- NPC SPOTS (v5): invisible 1 x 1 x 1 parts named "NpcSpot" (in Interiors/<Shop>/Npcs) mark where
-- the shopkeepers and the bar's customers stand: position = the floor point between the feet,
-- LookVector = the way they face. Attributes NpcRole ("Bartender" | "Clerk" | "Patron"),
-- NpcName, NpcPose ("Idle" | "WipeCounter" | "LeanBar" | "SitStool" | "ArmsCrossed" | "Phone"),
-- NpcSeed (outfit variety) and, for SitStool, SeatHeight (seat top above the floor).

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")

local City = {}

-- How many parts we create before letting the server breathe.
local PARTS_PER_CHUNK = 300
-- Above this number of parts we warn (v5: the target is about 5500, the hard cap 5600).
local PARTS_WARNING = 5600

local SHAPES = { "Block", "Wedge", "Cylinder", "Ball" }

-- Columns of one part row in the data (1-based, see citygen.py export_luau).
local COL = {
	SHAPE = 1,
	X = 2,
	RX = 5,
	SX = 8,
	COLOR = 11,
	MATERIAL = 12,
	TRANSPARENCY = 13,
	REFLECTANCE = 14,
	FLAGS = 15,
	FOLDER = 16,
	NAME = 17,
	PARENT = 18,
	EXTRA = 19,
}

-- Bits of the FLAGS column.
local FLAG_COLLIDE = 1
local FLAG_QUERY = 2
local FLAG_SHADOW = 4

type CityData = {
	colors: { { number } },
	materials: { string },
	folders: { string },
	names: { string },
	parts: { { number } },
	extras: { { [string]: any } },
	spawns: { { number } },
	dummy: { number }?,
	-- v5: the train lane (see THE TRAIN above)
	train: { a: { number }, b: { number }, laneWidth: number }?,
}

------------------------------------------------------------------------------
-- Reading the data
------------------------------------------------------------------------------

-- Joins CityData1, CityData2, ... (in order) and decodes the JSON.
local function loadData(): CityData
	local pieces = {}
	local index = 1
	while true do
		local module = script:FindFirstChild(`CityData{index}`)
		if module == nil or not module:IsA("ModuleScript") then
			break
		end
		table.insert(pieces, require(module) :: any)
		index += 1
	end
	return HttpService:JSONDecode(table.concat(pieces)) :: CityData
end

local function hasBit(value: number, bit: number): boolean
	return bit32.band(value, bit) ~= 0
end

local function toColor(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

------------------------------------------------------------------------------
-- Folders
------------------------------------------------------------------------------

-- Returns (and creates if needed) the folder for a path like "Buildings/B1/Facade_S".
-- Facade_* containers are Models (one breakable wall face each), the rest are Folders.
local function makeFolderGetter(root: Instance): (string) -> Instance
	local cache: { [string]: Instance } = {}
	local function get(path: string): Instance
		local found = cache[path]
		if found then
			return found
		end
		local parent = root
		local name = path
		local slash = string.find(path, "/[^/]*$")
		if slash then
			parent = get(string.sub(path, 1, slash - 1))
			name = string.sub(path, slash + 1)
		end
		local container: Instance
		if string.sub(name, 1, 7) == "Facade_" then
			container = Instance.new("Model")
			container.Name = name
		elseif string.sub(name, 1, 10) == "Mannequin_" then
			-- "Mannequin_OutfitOlive" -> a Model named "Mannequin" wearing OutfitOlive
			container = Instance.new("Model")
			container.Name = "Mannequin"
			container:SetAttribute("OutfitId", string.sub(name, 11))
		else
			container = Instance.new("Folder")
			container.Name = name
		end
		container.Parent = parent
		cache[path] = container
		return container
	end
	return get
end

------------------------------------------------------------------------------
-- Extras: lights, signs, particles
------------------------------------------------------------------------------

local function addLight(part: BasePart, info: { [string]: any })
	local light: Light
	if info.type == "Spot" then
		local spot = Instance.new("SpotLight")
		spot.Angle = info.angle or 90
		spot.Face = (Enum.NormalId :: any)[info.face or "Bottom"]
		light = spot
	else
		light = Instance.new("PointLight")
	end
	light.Name = info.name or "Light"
	light.Color = toColor(info.color)
	light.Brightness = info.brightness;
	(light :: any).Range = info.range
	light.Shadows = info.shadows == true
	light.Enabled = info.enabled ~= false
	light.Parent = part
end

-- Text on a part (shop signs, graffiti, posters): SurfaceGui + TextLabel, built-in fonts only.
local function addSign(part: BasePart, info: { [string]: any })
	local surface = Instance.new("SurfaceGui")
	surface.Name = "Sign"
	surface.Face = (Enum.NormalId :: any)[info.face]
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = 25
	if info.lit then
		-- Neon-looking text: not affected by the scene's light (Ambience changes Brightness).
		surface.LightInfluence = 0
		surface.Brightness = 2.5
	else
		surface.LightInfluence = 1
	end
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.Text = info.text
	label.Font = (Enum.Font :: any)[info.font] or Enum.Font.Oswald
	label.TextColor3 = toColor(info.color)
	if info.bg and info.bg_tr ~= nil and info.bg_tr < 1 then
		label.BackgroundColor3 = toColor(info.bg)
		label.BackgroundTransparency = info.bg_tr
	else
		label.BackgroundTransparency = 1
	end
	label.BorderSizePixel = 0
	label.Parent = surface
	surface.Parent = part
end

-- Particle presets (built-in textures only).
local function addParticles(part: BasePart, preset: string)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FX"
	if preset == "steam" or preset == "steam_small" then
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
		emitter.LightEmission = 0.05
		emitter.Transparency = NumberSequence.new(0.55, 1)
		emitter.Size = NumberSequence.new(if preset == "steam" then 3 else 1.5, 12)
		emitter.Rate = if preset == "steam" then 6 else 3
		emitter.Lifetime = NumberRange.new(4, 6)
		emitter.Speed = NumberRange.new(4, 7)
		emitter.SpreadAngle = Vector2.new(12, 12)
		emitter.Acceleration = Vector3.new(1.5, 0.5, 0)
		emitter.EmissionDirection = if preset == "steam"
			then Enum.NormalId.Top
			else Enum.NormalId.Left
	elseif preset == "fire" then
		emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 170, 80), Color3.fromRGB(200, 60, 20))
		emitter.LightEmission = 0.8
		emitter.Transparency = NumberSequence.new(0.2, 1)
		emitter.Size = NumberSequence.new(1.6, 0.4)
		emitter.Rate = 24
		emitter.Lifetime = NumberRange.new(0.6, 1.1)
		emitter.Speed = NumberRange.new(3, 5)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.EmissionDirection = Enum.NormalId.Top
	elseif preset == "drip" then
		-- Only on when it rains (the weather turns CityDrip emitters on).
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(170, 180, 190))
		emitter.Transparency = NumberSequence.new(0.4)
		emitter.Size = NumberSequence.new(0.12)
		emitter.Rate = 3
		emitter.Lifetime = NumberRange.new(1.2, 1.2)
		emitter.Speed = NumberRange.new(0, 0)
		emitter.Acceleration = Vector3.new(0, -120, 0)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Enabled = false
	end
	emitter.Parent = part
end

-- A "press E" prompt on a part that carries the attributes PromptText and PromptObject
-- (the two ShopCounters). The Shop system finds it by its name, "ShopPrompt".
local function addPrompt(part: BasePart, actionText: string, objectText: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	-- The counter's top is in the way of the ray from the camera: don't require a clear view.
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = part
end

local function applyExtras(part: BasePart, extra: { [string]: any })
	if extra.t then
		for _, tag in extra.t do
			CollectionService:AddTag(part, tag)
		end
	end
	if extra.a then
		for key, value in extra.a do
			part:SetAttribute(key, value)
		end
	end
	if extra.l then
		addLight(part, extra.l)
	end
	if extra.g then
		addSign(part, extra.g)
	end
	if extra.fx then
		addParticles(part, extra.fx)
	end
	local attributes = extra.a
	if
		attributes
		and typeof(attributes.PromptText) == "string"
		and typeof(attributes.PromptObject) == "string"
	then
		addPrompt(part, attributes.PromptText, attributes.PromptObject)
	end
end

------------------------------------------------------------------------------
-- Parts
------------------------------------------------------------------------------

local function makePart(row: { number }, data: CityData): BasePart
	local shape = SHAPES[row[COL.SHAPE]]
	local part: BasePart
	if shape == "Wedge" then
		part = Instance.new("WedgePart")
	else
		local block = Instance.new("Part")
		if shape == "Cylinder" then
			block.Shape = Enum.PartType.Cylinder
		elseif shape == "Ball" then
			block.Shape = Enum.PartType.Ball
		end
		part = block
	end
	part.Anchored = true
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Name = data.names[row[COL.NAME]]
	part.Size = Vector3.new(row[COL.SX], row[COL.SX + 1], row[COL.SX + 2])
	part.CFrame = CFrame.new(row[COL.X], row[COL.X + 1], row[COL.X + 2])
		* CFrame.fromEulerAnglesYXZ(
			math.rad(row[COL.RX]),
			math.rad(row[COL.RX + 1]),
			math.rad(row[COL.RX + 2])
		)
	part.Color = toColor(data.colors[row[COL.COLOR]])
	part.Material = (Enum.Material :: any)[data.materials[row[COL.MATERIAL]]]
	part.Transparency = row[COL.TRANSPARENCY]
	part.Reflectance = row[COL.REFLECTANCE]
	local flags = row[COL.FLAGS]
	part.CanCollide = hasBit(flags, FLAG_COLLIDE)
	part.CanQuery = hasBit(flags, FLAG_QUERY)
	part.CastShadow = hasBit(flags, FLAG_SHADOW)
	return part
end

local function buildSpawns(city: Instance, spawns: { { number } })
	local folder = Instance.new("Folder")
	folder.Name = "Spawns"
	folder.Parent = city
	for index, spot in spawns do
		local spawnPoint = Instance.new("SpawnLocation")
		spawnPoint.Name = `Spawn{index}`
		spawnPoint.Anchored = true
		spawnPoint.Size = Vector3.new(6, 1, 6)
		-- The top face is 0.1 above the surface under it.
		spawnPoint.Position = Vector3.new(spot[1], spot[2] + 0.1 - 0.5, spot[3])
		spawnPoint.Transparency = 1
		spawnPoint.CanCollide = false
		spawnPoint.CanTouch = true
		spawnPoint.Duration = 0 -- our own spawn protection (Knockout) is used
		spawnPoint.Neutral = true
		local decal = spawnPoint:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
		spawnPoint.Parent = folder
	end
end

-- Removes what Studio's "Baseplate" template puts in a new place:
--   * the Baseplate (2048 x 16 x 2048, its top at Y = 0): it would show through the streets;
--   * the default SpawnLocation (its top at Y = 1.0): it is disabled and hidden, not destroyed,
--     in case another script holds a reference to it.
-- Called once the city's ground exists (see build), never before.
-- Terrain is left alone: the city's base slab (top at Y = 1.2) covers flat terrain.
local function cleanUpTemplate()
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate:Destroy()
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			child.Enabled = false
			child.Transparency = 1
			child.CanCollide = false
			child.CanQuery = false
			child.CanTouch = false
			child.Position = Vector3.new(child.Position.X, -50, child.Position.Z)
			local decal = child:FindFirstChildOfClass("Decal")
			if decal then
				decal.Transparency = 1
			end
		end
	end
end

-- Creates every part, a chunk at a time.
-- The "Ground" parts come first in the data: they are all created in one go (no wait), and only
-- then is the template's Baseplate removed. So there is always a floor under the spawns.
local function build(city: Folder, data: CityData)
	local getFolder = makeFolderGetter(city)
	local created: { BasePart } = table.create(#data.parts)
	local sinceWait = 0
	local lastZone = ""
	local groundDone = false
	for index, row in data.parts do
		local part = makePart(row, data)
		local path = data.folders[row[COL.FOLDER]]
		local parentIndex = row[COL.PARENT]
		local extraIndex = row[COL.EXTRA]
		if extraIndex > 0 then
			applyExtras(part, data.extras[extraIndex])
		end
		if parentIndex > 0 then
			part.Parent = created[parentIndex] -- decoration hangs under its panel
		else
			part.Parent = getFolder(path)
		end
		created[index] = part
		-- Breathe between chunks, and whenever a new zone starts, but never inside the ground.
		local zone = string.match(path, "^[^/]*") or path
		sinceWait += 1
		if not groundDone then
			if zone == "Ground" then
				lastZone = zone
				continue -- keep going: the whole ground is built in this frame
			end
			-- The first part after the ground: the city has a floor now.
			groundDone = true
			cleanUpTemplate()
		end
		if sinceWait >= PARTS_PER_CHUNK or zone ~= lastZone then
			sinceWait = 0
			lastZone = zone
			task.wait()
		end
	end
	if not groundDone then
		cleanUpTemplate() -- (a city made of ground only: still clear the template)
	end
	local count = 0
	for _, descendant in city:GetDescendants() do
		if descendant:IsA("BasePart") then
			count += 1
		end
	end
	if count > PARTS_WARNING then
		warn(`[City] {count} parts: over the {PARTS_WARNING} budget`)
	end
	city:SetAttribute("Built", true)
	city:SetAttribute("PartCount", count)
end

------------------------------------------------------------------------------
-- Lifecycle
------------------------------------------------------------------------------

function City.init()
	if workspace:FindFirstChild("City") then
		return -- a hand-made map is in the place: keep it
	end
	local data = loadData()
	local city = Instance.new("Folder")
	city.Name = "City"
	city:SetAttribute("Built", false)
	local dummy = data.dummy
	if dummy then
		city:SetAttribute("DummySpot", Vector3.new(dummy[1], dummy[2], dummy[3]))
	end
	-- The train lane (read by the train system): set before the folder is parented.
	local train = data.train
	if train then
		city:SetAttribute("TrainA", Vector3.new(train.a[1], train.a[2], train.a[3]))
		city:SetAttribute("TrainB", Vector3.new(train.b[1], train.b[2], train.b[3]))
		city:SetAttribute("TrainLaneWidth", train.laneWidth)
	end
	city.Parent = workspace
	buildSpawns(city, data.spawns)
	-- The parts are built in the background so the other systems can start. task.spawn runs
	-- build right away, up to its first wait: the ground is complete before City.init returns,
	-- and only then is the template's Baseplate removed.
	task.spawn(build, city, data)
end

return City
