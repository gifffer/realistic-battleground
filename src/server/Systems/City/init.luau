--!strict
-- City: "Marrow District", the free arena, built by code when the server starts.
--
-- The district itself is DATA: the CityData1..N modules next to this script are generated by a
-- Python tool (citygen.py, kept outside the game) from the art direction document. They hold one
-- JSON text, split in pieces, that lists every part of the city (about 6 100 primitive parts:
-- a compact district for 16 players with 9 buildings, 3 shops you can walk into, the railway
-- viaduct, climb routes, props, the boundary ring) plus the spawn points. This script only
-- READS that list and creates the Instances. To change the city, change the generator and
-- export again; do not edit CityData by hand. Fixes to the generated city that must survive a
-- new export go in the CityOverlay (see THE CITY OVERLAY below; tools/city/overlay/).
--
-- Everything goes into Workspace > City, one folder per zone ("Ground", "Buildings/B1", ...).
-- If a Folder named "City" already exists in Workspace (a hand-made map in the place file),
-- nothing is built: the hand-made map wins.
--
-- HEIGHTS: the road surface of the city is at Y = 1.2 (not 0). Studio's default Baseplate has
-- its top at Y = 0 and the default SpawnLocation its top at Y = 1.0: a city road at Y = 0 sat
-- exactly on the Baseplate, which made its grid texture flicker through the asphalt
-- ("z-fighting") and made the road look sunk. This script also removes the default Baseplate
-- and hides the default SpawnLocation (see cleanUpTemplate below), but only AFTER the city's
-- own ground exists, so nobody who spawns early falls into the void.
--
-- The build runs in the background, a few hundred parts at a time with task.wait() between
-- chunks, so the server never freezes. The spawn points and the whole ground (the "Ground"
-- folder: road slab, sidewalks, area floors) are created first, in the same frame, with no
-- wait in between.
--
-- Tags (CollectionService) used by Server/Systems/Ambience and the weather events:
--   CityLamp        lamp heads (child SpotLight / PointLight "Light"); attributes Dead, Flicker
--   CityNeon        neon signs (child SurfaceGui "Sign" + PointLight "Light"); attribute Flicker
--   CityPuddle      puddles; attribute RainOnly
--   CityWindowLit   window panes that light up at night; attributes Kind ("warm"/"tv"/"cold"), Day
--   CityWetSurface  big road / roof slabs (Reflectance up when it rains)
--   CityDrip        drip emitters (only on in rain)
--   CitySteam       steam vents (ParticleEmitter, attribute BaseRate)
--   CityFire        burn barrels; CityEmergency red exit lights (power cut only)
--   CityBulkhead, CityShopLight, CityGutter: other lights / gutter spouts
--   ShopCounter     the counters of the clothes shop (THREADBARE) and the emote shop (REWIND).
--                   Attributes ShopCategory ("Outfit" / "Emote"), PromptText, PromptObject.
--                   This script gives each one a ProximityPrompt named "ShopPrompt" (press E).
--                   The shop system listens to that prompt to open the shop menu on the right
--                   tab. The shop button of the menu still works as before.
--
-- BREAKABLE WALLS (for later, nothing breaks yet):
--   Every ground-floor wall element of the buildings is a separate anchored part tagged
--   "Breakable", with attributes Material ("Brick" | "Concrete" | "Wood" | "Glass" | "Metal"),
--   Health (Brick 120, Concrete 160, Wood 50, Glass 10, Metal 90), Facade (e.g. "B1_S"),
--   Row (1 = Y 0..8, 2 = Y 8..16) and Slot (the 8-stud column along the facade).
--   The standard panel is 8 x 8 x 1.2. Its decoration (glass, sills, bars, boards, lights...)
--   is parented UNDER the panel, so it goes with it. Nothing structural rests on a panel:
--   ceilings, upper floors, string courses and fascias are held by the core and corner piers.
--   Behind every panel there is a dark room 10 studs deep, so a character thrown through a
--   wall lands inside. Panels of one face are in City/Buildings/<Id>/Facade_<Face> (a Model).
--   Note: the upper walls, parapets and the bar's ceiling simply sit on top of the ground-floor
--   panels. They are anchored, so they stay in the air when a panel under them breaks (no
--   collapse to simulate); a wall-breaking system must not unanchor anything but the panel.
--   For the future physics: unanchor the hit panel (default densities: Brick 1.92,
--   Concrete 2.4, Wood 0.7, Glass 2.4, Metal 7.85), put the pieces in a "Debris" collision
--   group that does not collide with itself, clean them up after 20 s. Never weld panels.
--
-- MANNEQUINS: the 4 mannequins of the clothes shop are Models named "Mannequin" with the
-- attribute OutfitId (the data names their folder "Mannequin_<OutfitId>"); the client's
-- ShopFrontController dresses them in that outfit.
--
-- THE SECRET PARK (v6): "Marrow Gardens", outside the west ring, reached by a narrow ginnel in
-- the Cage forecourt's south-west corner (a rusted half-open gate) and a covered passage
-- through the ring. Its parts are in City/Park. Invisible boxes (no collision, no queries) in
-- City/Audio describe the zones for the client / server code:
--   ParkZone    tag "ParkZone": the park volume (up to 60 high) + the covered passage
--               (always sunny, no weather, no fights there)
--   MusicZone   tag "MusicZone", attribute Zone = "Bar" | "Threads" | "Rewind" | "Park"
-- SPEAKERS: the cabinet part of every speaker is tagged "Speaker" with the attribute Zone (the
-- same names); its LookVector is the way it plays. Duffy's 3, THREADBARE 2, REWIND 2, park 3.
-- SPEZCOLA MACHINES: 3 Models named "SpezColaMachine" (data folder "SpezColaMachine_<n>"),
-- tagged "SpezColaMachine" at the END of the build, PrimaryPart = "Body". Children: "Button"
-- (the prompt goes there), "Dispenser" (invisible; position = the tray opening, LookVector out
-- of the machine), "Hum" (invisible, the machine's centre, for its 3D hum).
--
-- TRAINING DUMMIES: the data gives a clear, lit spot for them (the Cage court); it is stored on
-- the City folder as the attribute DummySpot (a Vector3), read by Server/Systems/TrainingDummies.
--
-- THE TRAIN (v5): the railway deck has ONE track lane (10 wide) between two railings, with a
-- walkway on each side and three level crossings. Both ends of the track run into a dark tunnel
-- behind a portal in the ring wall. The data gives the lane; this script stores it on the City
-- folder (set BEFORE the folder is parented, so a script that finds workspace.City can read
-- them right away; they may still be missing on a hand-made map, so wait / check for nil):
--   TrainA          Vector3: the rail-top centreline point 40 studs inside the WEST tunnel
--   TrainB          Vector3: the same point inside the EAST tunnel (the train runs A <-> B)
--   TrainLaneWidth  number: the width of the lane (10); a character inside it gets hit
-- The two signals at the deck's ends: a red lamp (part "TrainSignal", tag "TrainSignal", a
-- PointLight "Light", dark at rest) above a green one (part "SignalGo", tag "TrainSignalGo",
-- lit at rest), both with the attribute TrainEnd ("A" west / "B" east). The train code
-- (Client/Controllers/TrainController) blinks the red one and turns the green one off while a
-- train is coming or passing.
--
-- SALOON DOORS (v5): Duffy's corner entrance has two swinging half doors. Their parts carry the
-- usual CityDoor tag and attributes (DoorGroup "B12_Saloon", HingeX, HingeZ, OpenAngle = the
-- swing into the bar) plus DoorStyle = "Saloon"; they never collide. Server/Systems/CityDoors
-- swings them away from whoever walks through and lets them flap shut.
--
-- NPC SPOTS (v5): invisible 1 x 1 x 1 parts named "NpcSpot" (in Interiors/<Shop>/Npcs) mark where
-- the shopkeepers and the bar's customers stand: position = the floor point between the feet,
-- LookVector = the way they face. Attributes NpcRole ("Bartender" | "Clerk" | "Patron"),
-- NpcName, NpcPose ("Idle" | "WipeCounter" | "LeanBar" | "SitStool" | "ArmsCrossed" | "Phone"),
-- NpcSeed (outfit variety) and, for SitStool, SeatHeight (seat top above the floor).

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CityZones = require(ReplicatedStorage.Shared.Util.CityZones)

local PropKit = require(script.PropKit)

local City = {}

-- How many parts we create before letting the server breathe.
local PARTS_PER_CHUNK = 300
-- Above this number of parts we warn (v8: the generator's hard cap is 7000 parts; the
-- alleys, AlleyData, add about 3 700: their detailed dressing).
local PARTS_WARNING = 11500

-- v6: the SpezCola vending machines (see SPEZCOLA MACHINES at the top of this file).
local SPEZCOLA_PREFIX = "SpezColaMachine_"
local SPEZCOLA_TAG = "SpezColaMachine"

local SHAPES = { "Block", "Wedge", "Cylinder", "Ball" }

-- Columns of one part row in the data (1-based, see citygen.py export_luau).
local COL = {
	SHAPE = 1,
	X = 2,
	RX = 5,
	SX = 8,
	COLOR = 11,
	MATERIAL = 12,
	TRANSPARENCY = 13,
	REFLECTANCE = 14,
	FLAGS = 15,
	FOLDER = 16,
	NAME = 17,
	PARENT = 18,
	EXTRA = 19,
}

-- Bits of the FLAGS column.
local FLAG_COLLIDE = 1
local FLAG_QUERY = 2
local FLAG_SHADOW = 4

type CityData = {
	colors: { { number } },
	materials: { string },
	folders: { string },
	names: { string },
	parts: { { number } },
	extras: { { [string]: any } },
	spawns: { { number } },
	dummy: { number }?,
	-- v5: the train lane (see THE TRAIN above)
	train: { a: { number }, b: { number }, laneWidth: number }?,
	-- Rows replaced by the alleys (see mergeAlleys): skipped when building.
	skip: { [number]: boolean }?,
}

-- CityOverlay (tools/city/overlay/build_overlay.py): whole-city fixes declared as operations on
-- the city's parts, found by folder + name + ORIGINAL position (see applyOverlay).
type OverlayMatch = { f: string, n: string, at: { number } }
type OverlayOp = {
	op: string, -- "set" | "remove" | "add" | "parent"
	m: OverlayMatch?,
	under: OverlayMatch?,
	to: OverlayMatch?,
	p: number?,
	color: number?,
	material: number?,
	tr: number?,
	refl: number?,
	flags: number?,
	shape: number?,
	pos: { number }?,
	rot: { number }?,
	size: { number }?,
	extra: number?,
	xp: number?,
}
type OverlayData = {
	colors: { { number } },
	materials: { string },
	folders: { string },
	names: { string },
	parts: { { number } },
	extras: { { [string]: any } },
	entries: { { id: string, ops: { OverlayOp } } },
}

-- AlleyData (tools/city/alleys.py): the same tables, plus the city parts it replaces.
type AlleyData = {
	colors: { { number } },
	materials: { string },
	folders: { string },
	names: { string },
	parts: { { number } },
	extras: { { [string]: any } },
	remove: { { folder: string, name: string, at: { number } } },
}

------------------------------------------------------------------------------
-- Reading the data
------------------------------------------------------------------------------

-- Joins CityData1, CityData2, ... (in order) and decodes the JSON.
local function loadData(): CityData
	local pieces = {}
	local index = 1
	while true do
		local module = script:FindFirstChild(`CityData{index}`)
		if module == nil or not module:IsA("ModuleScript") then
			break
		end
		table.insert(pieces, require(module) :: any)
		index += 1
	end
	return HttpService:JSONDecode(table.concat(pieces)) :: CityData
end

-- Merging another data set (the alleys, the overlay) into the city's tables: its index -> the
-- city's (an equal entry is reused, else appended).
local function remapList(cityList: { any }, otherList: { any }, key: (any) -> string): { number }
	local known: { [string]: number } = {}
	for index, value in cityList do
		known[key(value)] = index
	end
	local map = {}
	for index, value in otherList do
		local found = known[key(value)]
		if found == nil then
			table.insert(cityList, value)
			found = #cityList
			known[key(value)] = found
		end
		map[index] = found
	end
	return map
end

local function rgbKey(rgb: any): string
	return `{rgb[1]},{rgb[2]},{rgb[3]}`
end

local function textKey(text: any): string
	return text
end

-- THE ALLEYS: the AlleyData1..N modules next to this script (generated by tools/city/alleys.py)
-- adds the two alleys along the viaduct east of the ring, their courtyard (black market,
-- squat) and the improvised-weapon spawn markers, in the same format. Its rows are appended
-- to the city's (its colors / materials / folders / names / extras indices are remapped onto
-- the city's tables); the city parts it replaces (the ring blocks a gap is cut into, the east
-- invisible wall) are found by folder, name and position and skipped.
local function mergeAlleys(data: CityData)
	-- (in pieces AlleyData1, AlleyData2... like CityData: Studio's script size limit)
	local pieces = {}
	local pieceIndex = 1
	while true do
		local module = script:FindFirstChild(`AlleyData{pieceIndex}`)
		if module == nil or not module:IsA("ModuleScript") then
			break
		end
		table.insert(pieces, require(module) :: any)
		pieceIndex += 1
	end
	if #pieces == 0 then
		return
	end
	local alleys = HttpService:JSONDecode(table.concat(pieces)) :: AlleyData
	local skip: { [number]: boolean } = {}
	for _, removal in alleys.remove do
		for index, row in data.parts do
			if
				data.folders[row[COL.FOLDER]] == removal.folder
				and data.names[row[COL.NAME]] == removal.name
				and math.abs(row[COL.X] - removal.at[1]) < 0.05
				and math.abs(row[COL.X + 1] - removal.at[2]) < 0.05
				and math.abs(row[COL.X + 2] - removal.at[3]) < 0.05
			then
				skip[index] = true
			end
		end
	end
	local colors = remapList(data.colors, alleys.colors, rgbKey)
	local materials = remapList(data.materials, alleys.materials, textKey)
	local folders = remapList(data.folders, alleys.folders, textKey)
	local names = remapList(data.names, alleys.names, textKey)
	local partOffset = #data.parts
	local extraOffset = #data.extras
	for _, extra in alleys.extras do
		table.insert(data.extras, extra)
	end
	for _, row in alleys.parts do
		local copy = table.clone(row)
		copy[COL.COLOR] = colors[row[COL.COLOR]]
		copy[COL.MATERIAL] = materials[row[COL.MATERIAL]]
		copy[COL.FOLDER] = folders[row[COL.FOLDER]]
		copy[COL.NAME] = names[row[COL.NAME]]
		if row[COL.PARENT] > 0 then
			copy[COL.PARENT] = row[COL.PARENT] + partOffset
		end
		if row[COL.EXTRA] > 0 then
			copy[COL.EXTRA] = row[COL.EXTRA] + extraOffset
		end
		table.insert(data.parts, copy)
	end
	data.skip = skip
end

-- THE CITY OVERLAY: the CityOverlay1..N modules next to this script (generated by
-- tools/city/overlay/build_overlay.py from tools/city/overlay/edits/*.py) fix the generated city
-- without editing CityData: CityData is regenerated by citygen.py, so every whole-city change
-- (colours, z-fights, signs moved onto proper plates, props wrapped into kit meshes...) is a list
-- of operations on parts found by folder + name + ORIGINAL position (tolerance 0.05):
--   set     changes columns of the part (colour, material, transparency, reflectance, flags,
--           shape, position, rotation, size) and/or its extra ("extra" replaces it, "xp"
--           patches it: the tables g / l / a merge field by field, "-" lists what to delete)
--   remove  drops the part (pure decoration only: the tool refuses anything alive)
--   add     a new part (the overlay's own palette, remapped like the alleys'), optionally under
--           a city part ("under")
--   parent  puts a city part under an added part (a MeshProp marker: PropKit then swaps in the
--           kit mesh, like in the alleys) or under another city part ("to")
-- The operations come in entries; an entry applies only when EVERY part it names is found
-- exactly once. When the city was regenerated and a part moved or vanished, that entry is
-- skipped whole and the original stays (counted in the one line printed at load).
local OVERLAY_TOLERANCE = 0.05

-- A new extra: base (or nothing) with the patch on top (see "set" above).
local function patchExtra(base: { [string]: any }?, patch: { [string]: any }): { [string]: any }
	local out: { [string]: any } = if base then table.clone(base) else {}
	local deletions = patch["-"]
	if typeof(deletions) == "table" then
		for _, path in deletions do
			local head, field = string.match(path, "^([^%.]+)%.(.+)$")
			if head and field then
				local sub = out[head]
				if typeof(sub) == "table" then
					local copy = table.clone(sub)
					copy[field] = nil
					out[head] = copy
				end
			else
				out[path] = nil
			end
		end
	end
	for key, value in patch do
		if key == "-" then
			continue
		end
		local current = out[key]
		if
			(key == "g" or key == "l" or key == "a")
			and typeof(value) == "table"
			and typeof(current) == "table"
		then
			local merged = table.clone(current)
			for field, fieldValue in value do
				merged[field] = fieldValue
			end
			out[key] = merged
		else
			out[key] = value
		end
	end
	return out
end

local function applyOverlay(data: CityData)
	local pieces = {}
	local pieceIndex = 1
	while true do
		local module = script:FindFirstChild(`CityOverlay{pieceIndex}`)
		if module == nil or not module:IsA("ModuleScript") then
			break
		end
		table.insert(pieces, require(module) :: any)
		pieceIndex += 1
	end
	if #pieces == 0 then
		return
	end
	local overlay = HttpService:JSONDecode(table.concat(pieces)) :: OverlayData
	if overlay.entries == nil or #overlay.entries == 0 then
		return
	end
	local skip = data.skip or {}
	data.skip = skip
	-- The parts that are built, by folder|name, with their ORIGINAL positions (an earlier "set"
	-- may move a part: later entries still find it where the generator put it).
	local byKey: { [string]: { number } } = {}
	local origin: { [number]: Vector3 } = {}
	for index, row in data.parts do
		if skip[index] then
			continue
		end
		local key = `{data.folders[row[COL.FOLDER]]}|{data.names[row[COL.NAME]]}`
		local list = byKey[key]
		if list == nil then
			list = {}
			byKey[key] = list
		end
		table.insert(list, index)
		origin[index] = Vector3.new(row[COL.X], row[COL.X + 1], row[COL.X + 2])
	end
	-- The one built row a match names, or nil (none, several, or removed).
	local function findRow(match: OverlayMatch): number?
		local candidates = byKey[`{match.f}|{match.n}`]
		if candidates == nil then
			return nil
		end
		local found: number? = nil
		local at = match.at
		for _, index in candidates do
			local position = origin[index]
			if
				not skip[index]
				and math.abs(position.X - at[1]) < OVERLAY_TOLERANCE
				and math.abs(position.Y - at[2]) < OVERLAY_TOLERANCE
				and math.abs(position.Z - at[3]) < OVERLAY_TOLERANCE
			then
				if found ~= nil then
					return nil -- (ambiguous)
				end
				found = index
			end
		end
		return found
	end
	local colors = remapList(data.colors, overlay.colors, rgbKey)
	local materials = remapList(data.materials, overlay.materials, textKey)
	local folders = remapList(data.folders, overlay.folders, textKey)
	local names = remapList(data.names, overlay.names, textKey)
	local function addExtra(extra: { [string]: any }): number
		table.insert(data.extras, extra)
		return #data.extras
	end
	local appliedOps, skippedOps = 0, 0
	for _, entry in overlay.entries do
		-- every part the entry names must be there, or nothing of it applies
		local rows: { [OverlayMatch]: number } = {}
		local complete = true
		for _, op in entry.ops do
			local named: { OverlayMatch } = {}
			for _, match in { op.m, op.under, op.to } :: { OverlayMatch? } do
				if match then
					table.insert(named, match)
				end
			end
			for _, match in named do
				local index = findRow(match)
				if index == nil then
					complete = false
					break
				end
				rows[match] = index
			end
			if not complete then
				break
			end
		end
		if not complete then
			skippedOps += #entry.ops
			continue
		end
		local added: { [number]: number } = {} -- overlay part -> data row
		for _, op in entry.ops do
			local target = if op.m then rows[op.m] else nil
			if op.op == "set" and target then
				local row = data.parts[target]
				if op.color then
					row[COL.COLOR] = colors[op.color]
				end
				if op.material then
					row[COL.MATERIAL] = materials[op.material]
				end
				if op.tr then
					row[COL.TRANSPARENCY] = op.tr
				end
				if op.refl then
					row[COL.REFLECTANCE] = op.refl
				end
				if op.flags then
					row[COL.FLAGS] = op.flags
				end
				if op.shape then
					row[COL.SHAPE] = op.shape
				end
				for column, values in { [COL.X] = op.pos, [COL.RX] = op.rot, [COL.SX] = op.size } do
					if values then
						row[column], row[column + 1], row[column + 2] =
							values[1], values[2], values[3]
					end
				end
				if op.extra then
					row[COL.EXTRA] = if op.extra > 0 then addExtra(overlay.extras[op.extra]) else 0
				end
				if op.xp then
					local base = if row[COL.EXTRA] > 0 then data.extras[row[COL.EXTRA]] else nil
					row[COL.EXTRA] = addExtra(patchExtra(base, overlay.extras[op.xp]))
				end
			elseif op.op == "remove" and target then
				skip[target] = true
			elseif op.op == "add" and op.p then
				local source = overlay.parts[op.p]
				local copy = table.clone(source)
				copy[COL.COLOR] = colors[source[COL.COLOR]]
				copy[COL.MATERIAL] = materials[source[COL.MATERIAL]]
				copy[COL.FOLDER] = folders[source[COL.FOLDER]]
				copy[COL.NAME] = names[source[COL.NAME]]
				if source[COL.EXTRA] > 0 then
					copy[COL.EXTRA] = addExtra(overlay.extras[source[COL.EXTRA]])
				end
				if op.under then
					copy[COL.PARENT] = rows[op.under]
				elseif source[COL.PARENT] > 0 then
					copy[COL.PARENT] = added[source[COL.PARENT]] or 0
				end
				table.insert(data.parts, copy)
				added[op.p] = #data.parts
			elseif op.op == "parent" and target then
				local newParent = if op.p then added[op.p] elseif op.to then rows[op.to] else nil
				if newParent then
					data.parts[target][COL.PARENT] = newParent
				end
			end
			appliedOps += 1
		end
	end
	print(`[CityOverlay] applied {appliedOps} ops, skipped {skippedOps} (city changed?)`)
end

local function hasBit(value: number, bit: number): boolean
	return bit32.band(value, bit) ~= 0
end

local function toColor(rgb: { number }): Color3
	return Color3.fromRGB(rgb[1], rgb[2], rgb[3])
end

------------------------------------------------------------------------------
-- Folders
------------------------------------------------------------------------------

-- Returns (and creates if needed) the folder for a path like "Buildings/B1/Facade_S".
-- Facade_* containers are Models (one breakable wall face each), the rest are Folders.
local function makeFolderGetter(root: Instance): (string) -> Instance
	local cache: { [string]: Instance } = {}
	local function get(path: string): Instance
		local found = cache[path]
		if found then
			return found
		end
		local parent = root
		local name = path
		local slash = string.find(path, "/[^/]*$")
		if slash then
			parent = get(string.sub(path, 1, slash - 1))
			name = string.sub(path, slash + 1)
		end
		local container: Instance
		if string.sub(name, 1, 7) == "Facade_" then
			container = Instance.new("Model")
			container.Name = name
		elseif string.sub(name, 1, 10) == "Mannequin_" then
			-- "Mannequin_OutfitOlive" -> a Model named "Mannequin" wearing OutfitOlive
			container = Instance.new("Model")
			container.Name = "Mannequin"
			container:SetAttribute("OutfitId", string.sub(name, 11))
		elseif string.sub(name, 1, #SPEZCOLA_PREFIX) == SPEZCOLA_PREFIX then
			-- "SpezColaMachine_2" -> a Model named "SpezColaMachine" (tagged once its parts
			-- exist, at the end of build)
			container = Instance.new("Model")
			container.Name = "SpezColaMachine"
		else
			container = Instance.new("Folder")
			container.Name = name
		end
		container.Parent = parent
		cache[path] = container
		return container
	end
	return get
end

------------------------------------------------------------------------------
-- Extras: lights, signs, particles
------------------------------------------------------------------------------

local function addLight(part: BasePart, info: { [string]: any })
	local light: Light
	if info.type == "Spot" then
		local spot = Instance.new("SpotLight")
		spot.Angle = info.angle or 90
		spot.Face = (Enum.NormalId :: any)[info.face or "Bottom"]
		light = spot
	else
		light = Instance.new("PointLight")
	end
	light.Name = info.name or "Light"
	light.Color = toColor(info.color)
	light.Brightness = info.brightness;
	(light :: any).Range = info.range
	light.Shadows = info.shadows == true
	light.Enabled = info.enabled ~= false
	light.Parent = part
end

-- Text on a part (shop signs, graffiti, posters): SurfaceGui + TextLabel, built-in fonts only.
-- The text fills the whole face (TextScaled). Optional fields, to frame a sign properly (all
-- default to the old look; the CityOverlay sets them):
--   pps        PixelsPerStud (default 25). TextScaled stops at 100 px, so the biggest text is
--              100 / pps studs high: small text needs a high pps to stay sharp
--   pad        UIPadding, in Scale of the face: a number, or { x, y }
--   maxSize    UITextSizeConstraint.MaxTextSize (px); minSize: MinTextSize
--   xalign     "Left" | "Center" | "Right"; yalign: "Top" | "Center" | "Bottom"
--   stroke     { color = { r, g, b }, tr = transparency } (TextStroke)
--   light      LightInfluence (default: 0 when lit, else 1); bright: Brightness (lit: 2.5)
--   textTr     TextTransparency (worn paint); rich: RichText; maxDist: MaxDistance
local function addSign(part: BasePart, info: { [string]: any })
	local surface = Instance.new("SurfaceGui")
	surface.Name = "Sign"
	surface.Face = (Enum.NormalId :: any)[info.face]
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.PixelsPerStud = if typeof(info.pps) == "number" then info.pps else 25
	if info.lit then
		-- Neon-looking text: not affected by the scene's light (Ambience changes Brightness).
		surface.LightInfluence = 0
		surface.Brightness = 2.5
	else
		surface.LightInfluence = 1
	end
	if typeof(info.light) == "number" then
		surface.LightInfluence = info.light
	end
	if typeof(info.bright) == "number" then
		surface.Brightness = info.bright
	end
	if typeof(info.maxDist) == "number" then
		surface.MaxDistance = info.maxDist
	end
	surface.ClipsDescendants = true
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.Size = UDim2.fromScale(1, 1)
	label.TextScaled = true
	label.RichText = info.rich == true
	label.Text = info.text
	label.Font = (Enum.Font :: any)[info.font] or Enum.Font.Oswald
	label.TextColor3 = toColor(info.color)
	if typeof(info.textTr) == "number" then
		label.TextTransparency = info.textTr
	end
	if typeof(info.xalign) == "string" then
		label.TextXAlignment = (Enum.TextXAlignment :: any)[info.xalign]
			or Enum.TextXAlignment.Center
	end
	if typeof(info.yalign) == "string" then
		label.TextYAlignment = (Enum.TextYAlignment :: any)[info.yalign]
			or Enum.TextYAlignment.Center
	end
	local stroke = info.stroke
	if typeof(stroke) == "table" and typeof(stroke.color) == "table" then
		label.TextStrokeColor3 = toColor(stroke.color)
		label.TextStrokeTransparency = if typeof(stroke.tr) == "number" then stroke.tr else 0
	end
	if info.bg and info.bg_tr ~= nil and info.bg_tr < 1 then
		label.BackgroundColor3 = toColor(info.bg)
		label.BackgroundTransparency = info.bg_tr
	else
		label.BackgroundTransparency = 1
	end
	label.BorderSizePixel = 0
	local pad = info.pad
	if typeof(pad) == "number" or typeof(pad) == "table" then
		local padX = if typeof(pad) == "number" then pad else (pad[1] or 0)
		local padY = if typeof(pad) == "number" then pad else (pad[2] or 0)
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(padX, 0)
		padding.PaddingRight = UDim.new(padX, 0)
		padding.PaddingTop = UDim.new(padY, 0)
		padding.PaddingBottom = UDim.new(padY, 0)
		padding.Parent = label
	end
	if typeof(info.maxSize) == "number" or typeof(info.minSize) == "number" then
		local constraint = Instance.new("UITextSizeConstraint")
		if typeof(info.maxSize) == "number" then
			constraint.MaxTextSize = math.clamp(math.floor(info.maxSize), 1, 100)
		end
		if typeof(info.minSize) == "number" then
			constraint.MinTextSize = math.clamp(math.floor(info.minSize), 1, 100)
		end
		constraint.Parent = label
	end
	label.Parent = surface
	surface.Parent = part
end

-- Particle presets (built-in textures only).
local function addParticles(part: BasePart, preset: string)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "FX"
	if preset == "steam" or preset == "steam_small" then
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(200, 200, 205))
		emitter.LightEmission = 0.05
		emitter.Transparency = NumberSequence.new(0.55, 1)
		emitter.Size = NumberSequence.new(if preset == "steam" then 3 else 1.5, 12)
		emitter.Rate = if preset == "steam" then 6 else 3
		emitter.Lifetime = NumberRange.new(4, 6)
		emitter.Speed = NumberRange.new(4, 7)
		emitter.SpreadAngle = Vector2.new(12, 12)
		emitter.Acceleration = Vector3.new(1.5, 0.5, 0)
		emitter.EmissionDirection = if preset == "steam"
			then Enum.NormalId.Top
			else Enum.NormalId.Left
	elseif preset == "fire" then
		emitter.Texture = "rbxasset://textures/particles/fire_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(255, 170, 80), Color3.fromRGB(200, 60, 20))
		emitter.LightEmission = 0.8
		emitter.Transparency = NumberSequence.new(0.2, 1)
		emitter.Size = NumberSequence.new(1.6, 0.4)
		emitter.Rate = 24
		emitter.Lifetime = NumberRange.new(0.6, 1.1)
		emitter.Speed = NumberRange.new(3, 5)
		emitter.SpreadAngle = Vector2.new(10, 10)
		emitter.EmissionDirection = Enum.NormalId.Top
	elseif preset == "drip" then
		-- Only on when it rains (the weather turns CityDrip emitters on).
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Color = ColorSequence.new(Color3.fromRGB(170, 180, 190))
		emitter.Transparency = NumberSequence.new(0.4)
		emitter.Size = NumberSequence.new(0.12)
		emitter.Rate = 3
		emitter.Lifetime = NumberRange.new(1.2, 1.2)
		emitter.Speed = NumberRange.new(0, 0)
		emitter.Acceleration = Vector3.new(0, -120, 0)
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Enabled = false
	end
	emitter.Parent = part
end

-- A "press E" prompt on a part that carries the attributes PromptText and PromptObject
-- (the two ShopCounters). The Shop system finds it by its name, "ShopPrompt".
local function addPrompt(part: BasePart, actionText: string, objectText: string)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ShopPrompt"
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	-- The counter's top is in the way of the ray from the camera: don't require a clear view.
	prompt.RequiresLineOfSight = false
	prompt.Style = Enum.ProximityPromptStyle.Default
	prompt.Parent = part
end

local function applyExtras(part: BasePart, extra: { [string]: any })
	if extra.t then
		for _, tag in extra.t do
			CollectionService:AddTag(part, tag)
		end
	end
	if extra.a then
		for key, value in extra.a do
			part:SetAttribute(key, value)
		end
	end
	if extra.l then
		addLight(part, extra.l)
	end
	if extra.g then
		addSign(part, extra.g)
	end
	if extra.fx then
		addParticles(part, extra.fx)
	end
	local attributes = extra.a
	if
		attributes
		and typeof(attributes.PromptText) == "string"
		and typeof(attributes.PromptObject) == "string"
	then
		addPrompt(part, attributes.PromptText, attributes.PromptObject)
	end
end

------------------------------------------------------------------------------
-- Parts
------------------------------------------------------------------------------

local function makePart(row: { number }, data: CityData): BasePart
	local shape = SHAPES[row[COL.SHAPE]]
	local part: BasePart
	if shape == "Wedge" then
		part = Instance.new("WedgePart")
	else
		local block = Instance.new("Part")
		if shape == "Cylinder" then
			block.Shape = Enum.PartType.Cylinder
		elseif shape == "Ball" then
			block.Shape = Enum.PartType.Ball
		end
		part = block
	end
	part.Anchored = true
	part.CanTouch = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Name = data.names[row[COL.NAME]]
	part.Size = Vector3.new(row[COL.SX], row[COL.SX + 1], row[COL.SX + 2])
	part.CFrame = CFrame.new(row[COL.X], row[COL.X + 1], row[COL.X + 2])
		* CFrame.fromEulerAnglesYXZ(
			math.rad(row[COL.RX]),
			math.rad(row[COL.RX + 1]),
			math.rad(row[COL.RX + 2])
		)
	part.Color = toColor(data.colors[row[COL.COLOR]])
	part.Material = (Enum.Material :: any)[data.materials[row[COL.MATERIAL]]]
	part.Transparency = row[COL.TRANSPARENCY]
	part.Reflectance = row[COL.REFLECTANCE]
	local flags = row[COL.FLAGS]
	part.CanCollide = hasBit(flags, FLAG_COLLIDE)
	part.CanQuery = hasBit(flags, FLAG_QUERY)
	part.CastShadow = hasBit(flags, FLAG_SHADOW)
	return part
end

local function buildSpawns(city: Instance, spawns: { { number } })
	local folder = Instance.new("Folder")
	folder.Name = "Spawns"
	folder.Parent = city
	for index, spot in spawns do
		local spawnPoint = Instance.new("SpawnLocation")
		spawnPoint.Name = `Spawn{index}`
		spawnPoint.Anchored = true
		spawnPoint.Size = Vector3.new(6, 1, 6)
		-- The top face is 0.1 above the surface under it.
		spawnPoint.Position = Vector3.new(spot[1], spot[2] + 0.1 - 0.5, spot[3])
		spawnPoint.Transparency = 1
		spawnPoint.CanCollide = false
		spawnPoint.CanTouch = true
		spawnPoint.Duration = 0 -- our own spawn protection (Knockout) is used
		spawnPoint.Neutral = true
		local decal = spawnPoint:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
		spawnPoint.Parent = folder
	end
end

-- Removes what Studio's "Baseplate" template puts in a new place:
--   * the Baseplate (2048 x 16 x 2048, its top at Y = 0): it would show through the streets;
--   * the default SpawnLocation (its top at Y = 1.0): it is disabled and hidden, not destroyed,
--     in case another script holds a reference to it.
-- Called once the city's ground exists (see build), never before.
-- Terrain is left alone: the city's base slab (top at Y = 1.2) covers flat terrain.
local function cleanUpTemplate()
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate and baseplate:IsA("BasePart") then
		baseplate:Destroy()
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			child.Enabled = false
			child.Transparency = 1
			child.CanCollide = false
			child.CanQuery = false
			child.CanTouch = false
			child.Position = Vector3.new(child.Position.X, -50, child.Position.Z)
			local decal = child:FindFirstChildOfClass("Decal")
			if decal then
				decal.Transparency = 1
			end
		end
	end
end

-- Copies the zone boxes (ParkZone / MusicZone) into ReplicatedStorage > CityZoneBoxes.
-- Why: with Workspace.StreamingEnabled (on by default in new places), a client only has the
-- parts of the workspace that are near it, so a zone box could be missing on a client and
-- "am I in the park?" would wrongly answer no. ReplicatedStorage is never streamed: every
-- client always has the copies. The copies carry no tag (the server's tag lists stay as they
-- are) but the attribute ZoneTag = the tag they stand for; Shared/Util/CityZones reads both.
local function mirrorZones(city: Instance)
	local old = ReplicatedStorage:FindFirstChild(CityZones.MIRROR_NAME)
	if old then
		old:Destroy()
	end
	local mirror = Instance.new("Folder")
	mirror.Name = CityZones.MIRROR_NAME
	for _, tag in { CityZones.PARK_TAG, CityZones.MUSIC_TAG, "AlleyZone" } do
		for _, instance in CollectionService:GetTagged(tag) do
			if instance:IsA("BasePart") and instance:IsDescendantOf(city) then
				local copy = instance:Clone()
				copy:ClearAllChildren()
				for _, copiedTag in copy:GetTags() do
					CollectionService:RemoveTag(copy, copiedTag)
				end
				copy:SetAttribute("ZoneTag", tag)
				copy.Parent = mirror
			end
		end
	end
	mirror.Parent = ReplicatedStorage
end

-- Creates every part, a chunk at a time.
-- The "Ground" parts come first in the data: they are all created in one go (no wait), and only
-- then is the template's Baseplate removed. So there is always a floor under the spawns.
local function build(city: Folder, data: CityData)
	local getFolder = makeFolderGetter(city)
	local created: { BasePart } = table.create(#data.parts)
	local sinceWait = 0
	local lastZone = ""
	local groundDone = false
	local skip = data.skip or {}
	local laterParents: { { part: BasePart, parent: number } } = {}
	for index, row in data.parts do
		if skip[index] then
			continue -- (replaced by the alleys, or removed by the overlay)
		end
		local part = makePart(row, data)
		local path = data.folders[row[COL.FOLDER]]
		local parentIndex = row[COL.PARENT]
		local extraIndex = row[COL.EXTRA]
		if extraIndex > 0 then
			applyExtras(part, data.extras[extraIndex])
		end
		if parentIndex > index and not skip[parentIndex] then
			-- (the overlay put this part under one built later, e.g. a MeshProp marker: it waits
			-- in its folder and moves once everything exists)
			part.Parent = getFolder(path)
			table.insert(laterParents, { part = part, parent = parentIndex })
		elseif parentIndex > 0 then
			part.Parent = created[parentIndex] -- decoration hangs under its panel
		else
			part.Parent = getFolder(path)
		end
		created[index] = part
		-- Breathe between chunks, and whenever a new zone starts, but never inside the ground.
		local zone = string.match(path, "^[^/]*") or path
		sinceWait += 1
		if not groundDone then
			if zone == "Ground" then
				lastZone = zone
				continue -- keep going: the whole ground is built in this frame
			end
			-- The first part after the ground: the city has a floor now.
			groundDone = true
			cleanUpTemplate()
		end
		if sinceWait >= PARTS_PER_CHUNK or zone ~= lastZone then
			sinceWait = 0
			lastZone = zone
			task.wait()
		end
	end
	if not groundDone then
		cleanUpTemplate() -- (a city made of ground only: still clear the template)
	end
	for _, pending in laterParents do
		local newParent = created[pending.parent]
		if newParent then
			pending.part.Parent = newParent
		end
	end
	local count = 0
	for _, descendant in city:GetDescendants() do
		if descendant:IsA("BasePart") then
			count += 1
		end
	end
	if count > PARTS_WARNING then
		warn(`[City] {count} parts: over the {PARTS_WARNING} budget`)
	end
	-- The SpezCola machines are complete now: give each its PrimaryPart (the red body) and its
	-- tag, so the SpezCola systems find a whole machine (Button, Dispenser, Hum all there).
	for _, descendant in city:GetDescendants() do
		if descendant:IsA("Model") and descendant.Name == "SpezColaMachine" then
			local body = descendant:FindFirstChild("Body")
			if body and body:IsA("BasePart") then
				descendant.PrimaryPart = body
			end
			CollectionService:AddTag(descendant, SPEZCOLA_TAG)
		end
	end
	-- The props marked "MeshProp" get their real mesh from the city prop kit (no kit: no change).
	PropKit.apply(city)
	mirrorZones(city)
	city:SetAttribute("Built", true)
	city:SetAttribute("PartCount", count)
end

------------------------------------------------------------------------------
-- Lifecycle
------------------------------------------------------------------------------

function City.init()
	if workspace:FindFirstChild("City") then
		return -- a hand-made map is in the place: keep it
	end
	local data = loadData()
	mergeAlleys(data)
	applyOverlay(data)
	local city = Instance.new("Folder")
	city.Name = "City"
	city:SetAttribute("Built", false)
	local dummy = data.dummy
	if dummy then
		city:SetAttribute("DummySpot", Vector3.new(dummy[1], dummy[2], dummy[3]))
	end
	-- The train lane (read by the train system): set before the folder is parented.
	local train = data.train
	if train then
		city:SetAttribute("TrainA", Vector3.new(train.a[1], train.a[2], train.a[3]))
		city:SetAttribute("TrainB", Vector3.new(train.b[1], train.b[2], train.b[3]))
		city:SetAttribute("TrainLaneWidth", train.laneWidth)
	end
	city.Parent = workspace
	buildSpawns(city, data.spawns)
	-- The parts are built in the background so the other systems can start. task.spawn runs
	-- build right away, up to its first wait: the ground is complete before City.init returns,
	-- and only then is the template's Baseplate removed.
	task.spawn(build, city, data)
end

return City
