--!strict
-- Firearms: the registry of the guns (docs/firearms/ARCHITECTURE.md, CORE.md).
--
-- Each gun is three files under this folder, collected AUTOMATICALLY (a gun's agent
-- only touches its own files; adding a gun = adding them):
--   Defs/<Id>.luau       its numbers (FirearmDef): fire, ammo, damage, spread, recoil,
--                        handling, ejection, muzzle, sounds, carry
--   Models/<Id>.luau     its model data, GENERATED by tools/guns/export_luau.py
--   Timelines/<Id>.luau  its reload / cycle / draw timings (generated later by the clip
--                        tool; placeholders now)
-- Shared by client and server; nothing secret (a client changing its copy changes
-- nothing on the server).
--
--   Firearms.get(id)        -> FirearmDef? (nil for anything that is not a gun id)
--   Firearms.list()         -> every gun, in `order`
--   Firearms.model(id)      -> GunModelData?
--   Firearms.timelines(id)  -> Timelines (empty table if the gun has none)
--   Firearms.timeline(id, name) -> Timeline?
--   Firearms.isAuto(def)    -> has an automatic mode
--   Firearms.interval(def)  -> seconds between two shots at its rpm
--   Firearms.BITS           the stance bits of the GunAim stream

local Types = require(script.Types)

export type FirearmDef = Types.FirearmDef
export type GunModelData = Types.GunModelData
export type Timeline = Types.Timeline
export type Timelines = Types.Timelines
export type AmmoState = Types.AmmoState
export type Zone = Types.Zone

local Firearms = {}

-- Stance bits sent with the aim stream (Remotes.GunAim) and relayed to everyone.
Firearms.BITS = table.freeze({
	Aim = 1,
	LowReady = 2,
	HighReady = 4,
	Sprint = 8,
	Bipod = 16,
	Crouch = 32,
	Obstructed = 64,
})

local defs: { [string]: FirearmDef } = {}
local ordered: { FirearmDef } = {}
local models: { [string]: GunModelData } = {}
local timelines: { [string]: Timelines } = {}
local EMPTY: Timelines = table.freeze({})

local function collect(folder: Instance?): { [string]: any }
	local out: { [string]: any } = {}
	if folder == nil then
		return out
	end
	for _, child in folder:GetChildren() do
		if child:IsA("ModuleScript") then
			out[child.Name] = require(child) :: any
		end
	end
	return out
end

for name, def in collect(script:FindFirstChild("Defs")) do
	local d = def :: FirearmDef
	assert(d.id == name, `Firearms: Defs/{name} has id {d.id}`)
	defs[name] = d
	table.insert(ordered, d)
end
table.sort(ordered, function(a, b)
	return a.order < b.order
end)
for name, model in collect(script:FindFirstChild("Models")) do
	models[name] = model :: GunModelData
end
for name, list in collect(script:FindFirstChild("Timelines")) do
	timelines[name] = list :: Timelines
end

function Firearms.get(id: unknown): FirearmDef?
	return if typeof(id) == "string" then defs[id] else nil
end

function Firearms.list(): { FirearmDef }
	return ordered
end

function Firearms.model(id: string): GunModelData?
	return models[id]
end

function Firearms.timelines(id: string): Timelines
	return timelines[id] or EMPTY
end

function Firearms.timeline(id: string, name: string): Timeline?
	local list = timelines[id]
	return if list then list[name] else nil
end

function Firearms.isAuto(def: FirearmDef): boolean
	return table.find(def.modes, "Auto") ~= nil
end

function Firearms.interval(def: FirearmDef): number
	return 60 / def.rpm
end

return table.freeze(Firearms)
